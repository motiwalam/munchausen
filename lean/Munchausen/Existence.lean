/-!
# One heuristic and existence (chapter 35)

* Proposition 35.3: the root factor averaged over the arrangements is a sum over the residues
  of the base (an exchange of two finite sums), with the term `r = 1` the digit sum;
* Proposition 35.5: in any commutative ring, the ideal of value differences of equivalent
  strings; it contains the ideal of the exchanges, equals it when the exchanges connect each
  class, and equals `(β - 1)` for geometric place values once two adjacent positions can
  exchange digits that differ by a unit, also with negative positions when `β` is a unit;
* Proposition 35.6: in `Z[t]/(f)` the ideal `(t - 1)` meets `Z` in `f(1) Z`, and in `Z[1/q]`
  the ideal `(p/q - 1)` meets `Z` in `(p - q) Z`;
* Proposition 35.8: the window of Lemma 20.1 computed from the large digits contains the base,
  widened by one; the small part `m(c_S)` is fixed by the large part and the base; and the
  small multisets with a given `m(c_S)` number at most `C(z0 + j, j)` (Lemma 30.2); the summed
  bound over the large parts, the leading digits and the bases of their windows;
* Theorem 35.12: at most `B^(max(1/2, C κ) + δ)` bases `b ≤ B` have a solution of at most
  `(ln B)^C` digits with at most `κ ln B / ln ln B` digits of weight at least `sqrt(b)`, by the
  windows computed from the large digits; for `C κ < 1` these bases have density 0;
* Proposition 35.9: the share of multisets without small digits is a product, with its two
  exponential bounds;
* Theorem 35.13 in full: the steering of the top digits of `F` by copies of one digit per
  position (`steer`, `steer_step`, `steer_zone`), the last step (a string whose top digits are
  those of its `F`, with no carry from the rest, is a near-solution, and an exchange below the
  top makes it a strict one), and `theorem35_13` with the real conditions (a) and (b);
* Corollary 35.14: near-solutions with `0 < |n - F(n)| < b^(b-2)` for `b ≥ 27`, and with
  `|n - F(n)| < n / b`, `n / b^2` for `b ≥ 49`, `b ≥ 77`; `T(b)` (`nearT`) and the exponent
  `t = T(b) - log_b(e b/(b - e))` do not decrease with `b`.
-/

namespace Munchausen

/-! ### Proposition 35.3 -/

/-- **Proposition 35.3** (section 35.1.2). Summed over the arrangements `s` of a multiset, the
number `N_s(q)` of residues `r` with `P_s(r) ≡ F (mod q)` is the sum over `r` of the number
of arrangements with `P_s(r) ≡ F (mod q)`. At `r = 1` every arrangement has `P_s(1)` equal to
the digit sum. -/
theorem prop35_3 (S : Finset (List ℕ)) (q F : ℕ) :
    ∑ s ∈ S, ((Finset.range q).filter fun r => P r s ≡ F [MOD q]).card =
      ∑ r ∈ Finset.range q, (S.filter fun s => P r s ≡ F [MOD q]).card := by
  simp only [Finset.card_filter]
  exact Finset.sum_comm

lemma P_one (s : List ℕ) : P (1 : ℕ) s = s.sum := by
  induction s using List.reverseRecOn with
  | nil => simp
  | append_singleton s d ih => simp [ih, add_comm]

/-! ### Proposition 35.5 -/

section Ideals

variable {R : Type*} [CommRing R]

/-- The invariant ideal `I_0` of section 35.3.1: generated by the differences
`u v_β(s) - u v_β(t)` of equivalent admissible strings (digits listed from position 0). -/
def invIdeal (A : Set (List R)) (β u : R) : Ideal R :=
  Ideal.span {x | ∃ s ∈ A, ∃ t ∈ A, s.Perm t ∧ x = u * ringVal β s - u * ringVal β t}

/-- An elementary exchange between admissible strings: the digits at two positions are
swapped. -/
def Exch (A : Set (List R)) (s t : List R) : Prop :=
  s ∈ A ∧ t ∈ A ∧ ∃ (a m c : List R) (x y : R), s = a ++ x :: (m ++ y :: c) ∧
    t = a ++ y :: (m ++ x :: c)

/-- The exchange ideal `J` of section 35.3.1: generated by the value changes of the
elementary exchanges. -/
def exchIdeal (A : Set (List R)) (β u : R) : Ideal R :=
  Ideal.span {z | ∃ s t, Exch A s t ∧ z = u * ringVal β s - u * ringVal β t}

/-- The value change of an exchange: `(x - y)(β^i - β^j)` at the positions
`i = |a|`, `j = |a| + |m| + 1`. -/
theorem ringVal_exch (β : R) (a m c : List R) (x y : R) :
    ringVal β (a ++ x :: (m ++ y :: c)) - ringVal β (a ++ y :: (m ++ x :: c)) =
      (x - y) * (β ^ a.length - β ^ (a.length + m.length + 1)) := by
  simp only [ringVal_append, ringVal]
  ring

/-- **Proposition 35.5 (1)** (section 35.3.1). The multiset fixes `u v(s)` modulo `I` exactly
when `I` contains `I_0`. -/
theorem prop35_5_one (A : Set (List R)) (β u : R) (I : Ideal R) :
    (∀ s ∈ A, ∀ t ∈ A, s.Perm t → u * ringVal β s - u * ringVal β t ∈ I) ↔
      invIdeal A β u ≤ I := by
  rw [invIdeal, Ideal.span_le]
  constructor
  · rintro h x ⟨s, hs, t, ht, hst, rfl⟩
    exact h s hs t ht hst
  · intro h s hs t ht hst
    exact h ⟨s, hs, t, ht, hst, rfl⟩

omit [CommRing R] in
lemma Exch.perm {A : Set (List R)} {s t : List R} (h : Exch A s t) : s.Perm t := by
  obtain ⟨-, -, a, m, c, x, y, rfl, rfl⟩ := h
  refine List.Perm.append_left a ?_
  exact ((List.Perm.cons x List.perm_middle).trans (List.Perm.swap y x _)).trans
    (List.Perm.cons y List.perm_middle).symm

/-- **Proposition 35.5 (2)** (section 35.3.1). The exchange ideal lies in `I_0`, and equals it
when the admissible strings of each multiset are connected by elementary exchanges. -/
theorem prop35_5_two (A : Set (List R)) (β u : R) :
    exchIdeal A β u ≤ invIdeal A β u ∧
      ((∀ s ∈ A, ∀ t ∈ A, s.Perm t → Relation.ReflTransGen (Exch A) s t) →
        exchIdeal A β u = invIdeal A β u) := by
  have hle : exchIdeal A β u ≤ invIdeal A β u := by
    rw [exchIdeal, Ideal.span_le]
    rintro z ⟨s, t, hst, rfl⟩
    exact Ideal.subset_span ⟨s, hst.1, t, hst.2.1, hst.perm, rfl⟩
  refine ⟨hle, fun hconn => le_antisymm hle ?_⟩
  rw [invIdeal, Ideal.span_le]
  rintro z ⟨s, hs, t, ht, hst, rfl⟩
  have key : ∀ t', Relation.ReflTransGen (Exch A) s t' →
      u * ringVal β s - u * ringVal β t' ∈ exchIdeal A β u := by
    intro t' h
    induction h with
    | refl => simp
    | @tail t1 t2 _ h2 ih =>
      have h3 : u * ringVal β t1 - u * ringVal β t2 ∈ exchIdeal A β u :=
        Ideal.subset_span ⟨t1, t2, h2, rfl⟩
      have := Ideal.add_mem _ ih h3
      simpa using this
  exact key t (hconn s hs t ht hst)

/-- **Proposition 35.5 (3)** (section 35.3.1), first half. With place values `u β^i`, every
value is `u` times the digit sum modulo `β - 1`, so `I_0 ⊆ (β - 1)`. -/
theorem prop35_5_three_le (A : Set (List R)) (β u : R) :
    invIdeal A β u ≤ Ideal.span {β - 1} := by
  rw [invIdeal, Ideal.span_le]
  rintro z ⟨s, -, t, -, hst, rfl⟩
  rw [SetLike.mem_coe, Ideal.mem_span_singleton]
  obtain ⟨a, ha⟩ := sub_one_dvd_ringVal_sub_sum β s
  obtain ⟨b, hb⟩ := sub_one_dvd_ringVal_sub_sum β t
  refine ⟨u * (a - b), ?_⟩
  rw [hst.sum_eq] at ha
  linear_combination u * ha - u * hb

/-- **Proposition 35.5 (3)** (section 35.3.1). If `u` is a unit and some admissible string
allows the exchange of two adjacent positions `i, i + 1` whose digits differ by a unit, with
`β^i` a unit, then `I_0 = (β - 1)`. -/
theorem prop35_5_three (A : Set (List R)) (β u : R) (hu : IsUnit u) {a c : List R} {x y : R}
    (h1 : a ++ x :: y :: c ∈ A) (h2 : a ++ y :: x :: c ∈ A) (hxy : IsUnit (x - y))
    (hβ : IsUnit (β ^ a.length)) : invIdeal A β u = Ideal.span {β - 1} := by
  refine le_antisymm (prop35_5_three_le A β u) ?_
  rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
  have hmem : u * ringVal β (a ++ x :: ([] ++ y :: c)) - u * ringVal β (a ++ y :: ([] ++ x :: c))
      ∈ invIdeal A β u :=
    Ideal.subset_span ⟨_, by simpa using h1, _, by simpa using h2,
      (Exch.perm (A := Set.univ) ⟨trivial, trivial, a, [], c, x, y, rfl, rfl⟩), rfl⟩
  have e : u * ringVal β (a ++ x :: ([] ++ y :: c)) - u * ringVal β (a ++ y :: ([] ++ x :: c)) =
      -(u * (x - y) * β ^ a.length) * (β - 1) := by
    rw [← mul_sub, ringVal_exch]; simp; ring
  rw [e] at hmem
  have hunit : IsUnit (-(u * (x - y) * β ^ a.length)) := ((hu.mul hxy).mul hβ).neg
  obtain ⟨v, hv⟩ := hunit
  have := Ideal.mul_mem_left _ (↑v⁻¹ : R) hmem
  rwa [← hv, ← mul_assoc, Units.inv_mul, one_mul] at this

end Ideals

section IdealsNeg

variable {R : Type*} [CommRing R]

/-- The invariant ideal `I_0` when positions may be negative (section 35.3.1, `β` a unit). An
admissible string is a pair `(k, s)`: the digits `s`, least significant first, start at
position `-k`, so the value is `u β^(-k) v_β(s)`. Equivalent strings have the same multiset
of digits, whatever their positions. -/
def invIdealZ (A : Set (ℕ × List R)) (β : Rˣ) (u : R) : Ideal R :=
  Ideal.span {z | ∃ s ∈ A, ∃ t ∈ A, s.2.Perm t.2 ∧
    z = u * ↑(β⁻¹ ^ s.1) * ringVal (β : R) s.2 - u * ↑(β⁻¹ ^ t.1) * ringVal (β : R) t.2}

/-- `β^(-k) ≡ 1 (mod β - 1)` for a unit `β`. -/
lemma sub_one_dvd_inv_pow_sub_one (β : Rˣ) (k : ℕ) : (β : R) - 1 ∣ ↑(β⁻¹ ^ k) - 1 := by
  have h1 : (β : R) - 1 ∣ ↑β⁻¹ - 1 := ⟨-↑β⁻¹, by rw [sub_mul, mul_neg, Units.mul_inv]; ring⟩
  have h2 : (↑β⁻¹ : R) - 1 ∣ (↑β⁻¹ : R) ^ k - 1 := by
    simpa using sub_dvd_pow_sub_pow (↑β⁻¹ : R) 1 k
  simpa using h1.trans h2

/-- **Proposition 35.5 (3)** for negative positions (section 35.3.1), first half. With place
values `u β^i`, `β` a unit and `i` any integer, every value is `u` times the digit sum modulo
`β - 1`, so `I_0 ⊆ (β - 1)`. -/
theorem prop35_5_three_neg_le (A : Set (ℕ × List R)) (β : Rˣ) (u : R) :
    invIdealZ A β u ≤ Ideal.span {(β : R) - 1} := by
  rw [invIdealZ, Ideal.span_le]
  rintro z ⟨⟨k, s⟩, -, ⟨l, t⟩, -, hst, rfl⟩
  rw [SetLike.mem_coe, Ideal.mem_span_singleton]
  obtain ⟨a, ha⟩ := sub_one_dvd_ringVal_sub_sum (β : R) s
  obtain ⟨b, hb⟩ := sub_one_dvd_ringVal_sub_sum (β : R) t
  obtain ⟨c, hc⟩ := sub_one_dvd_inv_pow_sub_one β k
  obtain ⟨d, hd⟩ := sub_one_dvd_inv_pow_sub_one β l
  have hsum : s.sum = t.sum := hst.sum_eq
  refine ⟨u * (↑(β⁻¹ ^ k) * a + c * s.sum - ↑(β⁻¹ ^ l) * b - d * t.sum), ?_⟩
  dsimp only
  linear_combination u * ↑(β⁻¹ ^ k) * ha + u * s.sum * hc - u * ↑(β⁻¹ ^ l) * hb -
    u * t.sum * hd + u * hsum

/-- **Proposition 35.5 (3)** for negative positions (section 35.3.1). If `u` and `β` are units
and some admissible string allows the exchange of two adjacent positions whose digits differ by
a unit, then `I_0 = (β - 1)`. Every power of `β`, also a negative one, is a unit here. -/
theorem prop35_5_three_neg (A : Set (ℕ × List R)) (β : Rˣ) (u : R) (hu : IsUnit u) {k : ℕ}
    {a c : List R} {x y : R} (h1 : (k, a ++ x :: y :: c) ∈ A) (h2 : (k, a ++ y :: x :: c) ∈ A)
    (hxy : IsUnit (x - y)) : invIdealZ A β u = Ideal.span {(β : R) - 1} := by
  refine le_antisymm (prop35_5_three_neg_le A β u) ?_
  rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
  have hperm : (a ++ x :: y :: c).Perm (a ++ y :: x :: c) :=
    List.Perm.append_left a (List.Perm.swap y x c)
  have hmem : u * ↑(β⁻¹ ^ k) * ringVal (β : R) (a ++ x :: y :: c) -
      u * ↑(β⁻¹ ^ k) * ringVal (β : R) (a ++ y :: x :: c) ∈ invIdealZ A β u :=
    Ideal.subset_span ⟨_, h1, _, h2, hperm, rfl⟩
  have e : u * ↑(β⁻¹ ^ k) * ringVal (β : R) (a ++ x :: y :: c) -
      u * ↑(β⁻¹ ^ k) * ringVal (β : R) (a ++ y :: x :: c) =
      -(u * ↑(β⁻¹ ^ k) * (x - y) * (β : R) ^ a.length) * ((β : R) - 1) := by
    have := ringVal_exch (β : R) a [] c x y
    simp only [List.nil_append, List.length_nil, add_zero] at this
    rw [← mul_sub, this]
    ring
  rw [e] at hmem
  have hunit : IsUnit (-(u * ↑(β⁻¹ ^ k) * (x - y) * (β : R) ^ a.length)) :=
    (((hu.mul (Units.isUnit _)).mul hxy).mul ((Units.isUnit β).pow _)).neg
  obtain ⟨v, hv⟩ := hunit
  have := Ideal.mul_mem_left _ (↑v⁻¹ : R) hmem
  rwa [← hv, ← mul_assoc, Units.inv_mul, one_mul] at this

end IdealsNeg

/-! ### Proposition 35.6 -/

/-- **Proposition 35.6** (section 35.3.1). In `Z[t]/(f)` (that is `Z[β]` for an algebraic
integer `β` with minimal polynomial `f`), the ideal `(β - 1)` meets `Z` in `f(1) Z`. -/
theorem prop35_6 (f : Polynomial ℤ) (n : ℤ) :
    (n : AdjoinRoot f) ∈ Ideal.span {AdjoinRoot.root f - 1} ↔ f.eval 1 ∣ n := by
  rw [Ideal.mem_span_singleton']
  constructor
  · rintro ⟨g, hg⟩
    obtain ⟨g', rfl⟩ := AdjoinRoot.mk_surjective g
    have h0 : AdjoinRoot.mk f (Polynomial.C n - g' * (Polynomial.X - 1)) = 0 := by
      simp [hg]
    obtain ⟨h, hh⟩ := AdjoinRoot.mk_eq_zero.1 h0
    have := congrArg (Polynomial.eval 1) hh
    simp only [Polynomial.eval_sub, Polynomial.eval_C, Polynomial.eval_mul, Polynomial.eval_X,
      Polynomial.eval_one, sub_self, mul_zero, sub_zero] at this
    exact ⟨h.eval 1, this⟩
  · rintro ⟨k, rfl⟩
    obtain ⟨q, hq⟩ := Polynomial.X_sub_C_dvd_sub_C_eval (a := 1) (p := f)
    refine ⟨-(AdjoinRoot.mk f q) * k, ?_⟩
    have h1 : AdjoinRoot.mk f (f - Polynomial.C (f.eval 1)) =
        AdjoinRoot.mk f ((Polynomial.X - Polynomial.C 1) * q) := by rw [hq]
    simp only [map_sub, AdjoinRoot.mk_self, zero_sub, map_mul, AdjoinRoot.mk_X,
      AdjoinRoot.mk_C, map_one] at h1
    rw [eq_intCast] at h1
    push_cast
    linear_combination (k : AdjoinRoot f) * h1

/-- **Proposition 35.6** (section 35.3.1), the rational bases. For coprime integers `p` and
`q ≥ 1`, an integer `n` lies in `(p/q - 1) Z[1/q]` exactly when `p - q ∣ n`. With `-p` in place
of `p` this is the base `-p/q` and the modulus `p + q`. -/
theorem prop35_6_rat {p q : ℤ} (hq : 1 ≤ q) (hpq : IsCoprime p q) (n : ℤ) :
    (∃ (a : ℤ) (k : ℕ), (n : ℚ) = ((p : ℚ) / q - 1) * (a / (q : ℚ) ^ k)) ↔ p - q ∣ n := by
  have hq0 : (q : ℚ) ≠ 0 := by exact_mod_cast (show q ≠ 0 by omega)
  constructor
  · rintro ⟨a, k, h⟩
    have h1 : n * q ^ (k + 1) = (p - q) * a := by
      have : (n : ℚ) * (q : ℚ) ^ (k + 1) = ((p : ℚ) - q) * a := by
        rw [h]; field_simp; ring
      exact_mod_cast this
    have hcop : IsCoprime (p - q) (q ^ (k + 1)) := by
      have : IsCoprime (p + (-1) * q) q := hpq.add_mul_right_left (-1)
      exact (by simpa [sub_eq_add_neg] using this : IsCoprime (p - q) q).pow_right
    exact hcop.dvd_of_dvd_mul_right ⟨a, h1⟩
  · rintro ⟨c, rfl⟩
    refine ⟨q * c, 0, ?_⟩
    push_cast
    field_simp

/-! ### Proposition 35.8: the window from the large digits -/

lemma pow_sub_one_add_pow_le {b : ℕ} (hb : 1 ≤ b) (i : ℕ) :
    (b - 1) ^ (i + 1) + b ^ i ≤ b ^ (i + 1) := by
  · have h1 : (b - 1) ^ i ≤ b ^ i := Nat.pow_le_pow_left (by omega) i
    have h2 : (b - 1) ^ (i + 1) = (b - 1) * (b - 1) ^ i := by rw [pow_succ']
    have h3 : b ^ (i + 1) = (b - 1) * b ^ i + b ^ i := by
      rw [pow_succ', ← Nat.succ_mul, Nat.succ_eq_add_one, Nat.sub_add_cancel hb]
    rw [h2, h3]
    exact Nat.add_le_add_right (Nat.mul_le_mul_left _ h1) _

/-- **Proposition 35.8** (section 35.4.1), the window. Let `n` be a solution in base `b` with
`k ≥ 3` digits, leading digit `p`, second digit at most `M`, and let `F'` be the weight of
the large digits: `F' ≤ n < F' + b` (the small weights add less than `b`). Then
`p (b - 1)^(k-1) < F' < p b^(k-1) + (M + 1) b^(k-2)`: the window of Lemma 20.1 computed from
`F'` contains `b`, widened by one base. No mean value theorem is needed. -/
theorem prop35_8_window {b m p q M F' : ℕ} {t : List ℕ} (hs : IsSolution b m (p :: q :: t))
    (ht : t ≠ []) (hq : q ≤ M) (hF1 : F' ≤ P b (p :: q :: t))
    (hF2 : P b (p :: q :: t) < F' + b) :
    p * (b - 1) ^ (t.length + 1) < F' ∧ F' < p * b ^ (t.length + 1) + (M + 1) * b ^ t.length := by
  obtain ⟨h1, h2⟩ := lemma20_1 hs hq
  have hp1 : 1 ≤ p := by
    have := hs.head_ne_zero (by simp); simp at this; omega
  have hb : 1 < b := by have := hs.lt_base p (by simp); omega
  refine ⟨?_, by omega⟩
  have hlen : 1 ≤ t.length := List.length_pos_iff.2 ht
  have k1 := pow_sub_one_add_pow_le (b := b) (by omega) t.length
  have k2 : b ≤ b ^ t.length := by
    calc b = b ^ 1 := (pow_one b).symm
      _ ≤ b ^ t.length := Nat.pow_le_pow_right (by omega) hlen
  have k3 : p * (b - 1) ^ (t.length + 1) + p * b ^ t.length ≤ p * b ^ (t.length + 1) := by
    rw [← mul_add]; exact Nat.mul_le_mul_left _ k1
  have k4 : b ≤ p * b ^ t.length := k2.trans (Nat.le_mul_of_pos_left _ hp1)
  omega

/-- **Proposition 35.8**, the window in roots: `b - 1 < (F'/p)^(1/(k-1)) < b + (M+1)/(p (k-1))`,
so `b` is one of the integers of the window of Lemma 20.1 computed from `F'`, or the one
below it. -/
theorem prop35_8_root {b m p q M F' : ℕ} {t : List ℕ} (hs : IsSolution b m (p :: q :: t))
    (ht : t ≠ []) (hq : q ≤ M) (hF1 : F' ≤ P b (p :: q :: t))
    (hF2 : P b (p :: q :: t) < F' + b) :
    (b : ℝ) - 1 < ((F' : ℝ) / p) ^ ((t.length + 1 : ℕ) : ℝ)⁻¹ ∧
      ((F' : ℝ) / p) ^ ((t.length + 1 : ℕ) : ℝ)⁻¹ < b + (M + 1) / (p * (t.length + 1 : ℕ)) := by
  obtain ⟨h1, -⟩ := prop35_8_window hs ht hq hF1 hF2
  obtain ⟨-, h3⟩ := lemma20_1_root hs hq
  have hp1 : 1 ≤ p := by
    have := hs.head_ne_zero (by simp); simp at this; omega
  have hb : 1 < b := by have := hs.lt_base p (by simp); omega
  have hpR : (0 : ℝ) < p := by exact_mod_cast hp1
  set j := t.length + 1
  have hj : (0 : ℝ) < ((j : ℕ) : ℝ)⁻¹ := by positivity
  have hb1 : (0 : ℝ) ≤ (b : ℝ) - 1 := by
    have : (1 : ℝ) < b := by exact_mod_cast hb
    linarith
  constructor
  · have hlt : ((b : ℝ) - 1) ^ j < (F' : ℝ) / p := by
      rw [lt_div_iff₀ hpR]
      have : ((p * (b - 1) ^ j : ℕ) : ℝ) < F' := by exact_mod_cast h1
      push_cast [Nat.cast_sub hb.le] at this
      linarith
    have := Real.rpow_lt_rpow (by positivity) hlt hj
    rwa [Real.pow_rpow_inv_natCast hb1 (by omega)] at this
  · refine lt_of_le_of_lt ?_ h3
    apply Real.rpow_le_rpow (by positivity) _ hj.le
    exact div_le_div_of_nonneg_right (by exact_mod_cast hF1) hpR.le

lemma sum_le_Fs (m : ℕ) (s : List ℕ) : s.sum ≤ Fs m s := by
  induction s with
  | nil => simp
  | cons d t ih => simp only [List.sum_cons, Fs_cons]; have := le_w' m d; omega

/-- **Proposition 35.8**, the small part is fixed. Let two solutions in base `b` have the same
large part `L` and small parts `S`, `S'` with `F(S), F(S') < b - 1`. Then
`m(S) = F(S) - σ(S)` equals `m(S')`: both lie in `[0, b - 2]` and are `≡ -m(L)` modulo
`b - 1`. -/
theorem prop35_8_fix {b m : ℕ} (hb : 2 ≤ b) {L S S' s s' : List ℕ} (hs : IsSolution b m s)
    (hs' : IsSolution b m s') (hp : s.Perm (L ++ S)) (hp' : s'.Perm (L ++ S'))
    (hS : Fs m S < b - 1) (hS' : Fs m S' < b - 1) :
    Fs m S - S.sum = Fs m S' - S'.sum := by
  have key : ∀ {u U : List ℕ}, IsSolution b m u → u.Perm (L ++ U) →
      (Fs m L - L.sum) + (Fs m U - U.sum) ≡ 0 [MOD b - 1] := by
    intro u U hu hpu
    have h1 := P_modEq_sum (b := b) (by omega) u
    rw [hu.eq] at h1
    have hF : Fs m u = Fs m L + Fs m U := by
      rw [← Fs_append]; unfold Fs; exact (hpu.map _).sum_eq
    have hsum : u.sum = L.sum + U.sum := by rw [← List.sum_append]; exact hpu.sum_eq
    rw [hF, hsum] at h1
    have hL := sum_le_Fs m L
    have hU := sum_le_Fs m U
    have e : Fs m L + Fs m U = (Fs m L - L.sum + (Fs m U - U.sum)) + (L.sum + U.sum) := by omega
    rw [e] at h1
    have := Nat.ModEq.add_right_cancel' (L.sum + U.sum) (h1.trans (by rw [zero_add]))
    exact this
  have h1 := key hs hp
  have h2 := key hs' hp'
  have h3 := Nat.ModEq.add_left_cancel' _ (h1.trans h2.symm)
  exact Nat.ModEq.eq_of_lt_of_lt h3 (by omega) (by omega)

/-- Multisets of `k` numbers at most `X` number at most `C(X + k, k)`. -/
lemma card_le_choose_of_bounded (T : Finset (Multiset ℕ)) (X k : ℕ)
    (hT : ∀ c ∈ T, Multiset.card c = k ∧ ∀ x ∈ c, x ≤ X) : T.card ≤ (X + k).choose k := by
  classical
  let cf : ℕ → Fin (X + 1) := fun d => ⟨d % (X + 1), Nat.mod_lt _ (by omega)⟩
  let f : Multiset ℕ → Sym (Fin (X + 1)) k := fun c =>
    if h : Multiset.card c = k then ⟨c.map cf, by simpa using h⟩
    else ⟨Multiset.replicate k 0, by simp⟩
  have key : ∀ c ∈ T, ((f c : Multiset (Fin (X + 1))).map Fin.val) = c := by
    intro c hc
    obtain ⟨h1, h2⟩ := hT c hc
    have hf : f c = ⟨c.map cf, by simpa using h1⟩ := by
      simp only [f, h1, ↓reduceDIte]
      rfl
    rw [hf, Sym.coe_mk, Multiset.map_map]
    conv_rhs => rw [← Multiset.map_id c]
    refine Multiset.map_congr rfl fun d hd => ?_
    simp only [Function.comp_apply, cf, id]
    exact Nat.mod_eq_of_lt (by have := h2 d hd; omega)
  have hinj : Set.InjOn f T := by
    intro c hc c' hc' h
    rw [← key c hc, ← key c' hc', h]
  calc T.card = (T.image f).card := (Finset.card_image_of_injOn hinj).symm
    _ ≤ (Finset.univ : Finset (Sym (Fin (X + 1)) k)).card := Finset.card_le_univ _
    _ = (X + k).choose k := by
        rw [Finset.card_univ, Sym.card_sym_eq_choose, Fintype.card_fin,
          show X + 1 + k - 1 = X + k by omega]

/-- `∑_(a ≤ z ≤ y) count_z(c) f(z)` is the sum of `f` over the elements of `c` that are at least
`a`, when every element is at most `y`. -/
lemma sum_Icc_count_mul {c : Multiset ℕ} {a y : ℕ} (f : ℕ → ℕ) (hc : ∀ x ∈ c, x ≤ y) :
    ∑ z ∈ Finset.Icc a y, c.count z * f z = ((c.filter (a ≤ ·)).map f).sum := by
  classical
  have h1 : ∀ z ∈ Finset.Icc a y, c.count z * f z = (c.filter (a ≤ ·)).count z * f z := by
    intro z hz
    rw [Multiset.count_filter_of_pos (Finset.mem_Icc.1 hz).1]
  have hsub : (c.filter (a ≤ ·)).toFinset ⊆ Finset.Icc a y := by
    intro z hz
    have h := Multiset.mem_filter.1 (Multiset.mem_toFinset.1 hz)
    exact Finset.mem_Icc.2 ⟨h.2, hc z h.1⟩
  rw [Finset.sum_multiset_map_count, Finset.sum_congr rfl h1,
    ← Finset.sum_subset (f := fun z => (c.filter (a ≤ ·)).count z * f z) hsub
      (fun z _ hz => by
        simp only [Multiset.mem_toFinset] at hz
        simp [Multiset.count_eq_zero.2 hz])]
  simp only [smul_eq_mul]

/-- **Proposition 35.8**, the bound on `r_j` (section 35.4.1). With `2 ≤ z0` and
`j ≤ 2 z0 + 1`, the multisets of `j` digits (all at most `y`) with a given value of
`m = ∑ g(x)` number at most `C(z0 + j, j)`: by Lemma 30.2 the digits from `z0` up are fixed
by the digits below `z0`, which form a multiset of at most `j` elements of `{0, ..., z0 - 1}`. -/
theorem prop35_8_count {m z0 j y N : ℕ} (hz0 : 2 ≤ z0) (hj : j ≤ 2 * z0 + 1)
    (S : Finset (Multiset ℕ))
    (hS : ∀ c ∈ S, Multiset.card c = j ∧ (∀ x ∈ c, x ≤ y) ∧ (c.map (g m)).sum = N) :
    S.card ≤ (z0 + j).choose j := by
  classical
  let φ : Multiset ℕ → Multiset ℕ := fun c =>
    c.filter (· < z0) + Multiset.replicate (j - Multiset.card (c.filter (· < z0))) z0
  have hlow : ∀ c, (φ c).filter (· < z0) = c.filter (· < z0) := by
    intro c
    have hrep : ∀ n, (Multiset.replicate n z0).filter (· < z0) = 0 := fun n =>
      Multiset.filter_eq_nil.2 fun x hx => by rw [Multiset.eq_of_mem_replicate hx]; omega
    simp only [φ]
    rw [Multiset.filter_add, hrep, add_zero, Multiset.filter_filter]
    exact Multiset.filter_congr fun x _ => and_self_iff
  -- the high part is determined by the low part
  have hinj : Set.InjOn φ S := by
    intro c hc c' hc' h
    obtain ⟨hcj, hcy, hcN⟩ := hS c hc
    obtain ⟨hcj', hcy', hcN'⟩ := hS c' hc'
    have hl : c.filter (· < z0) = c'.filter (· < z0) := by rw [← hlow c, ← hlow c', h]
    have hsplit : ∀ d : Multiset ℕ, d = d.filter (· < z0) + d.filter (z0 ≤ ·) := by
      intro d
      conv_lhs => rw [← Multiset.filter_add_not (· < z0) d]
      congr 1
      exact Multiset.filter_congr fun x _ => by omega
    have hcard : ∀ d : Multiset ℕ, Multiset.card d =
        Multiset.card (d.filter (· < z0)) + Multiset.card (d.filter (z0 ≤ ·)) := by
      intro d; conv_lhs => rw [hsplit d]
      rw [Multiset.card_add]
    have hsum : ∀ d : Multiset ℕ, (d.map (g m)).sum =
        ((d.filter (· < z0)).map (g m)).sum + ((d.filter (z0 ≤ ·)).map (g m)).sum := by
      intro d; conv_lhs => rw [hsplit d]
      rw [Multiset.map_add, Multiset.sum_add]
    have e1 := sum_Icc_count_mul (a := z0) (fun _ => 1) hcy
    have e1' := sum_Icc_count_mul (a := z0) (fun _ => 1) hcy'
    have e2 := sum_Icc_count_mul (a := z0) (g m) hcy
    have e2' := sum_Icc_count_mul (a := z0) (g m) hcy'
    simp only [mul_one, Multiset.map_const', Multiset.sum_replicate, smul_eq_mul] at e1 e1'
    have hc1 := hcard c
    have hc1' := hcard c'
    have hs1 := hsum c
    have hs1' := hsum c'
    rw [hl] at hc1 hs1
    have hcnt := lemma30_2 (m := m) (c := fun z => c.count z) (c' := fun z => c'.count z) hz0 y
      (by rw [e1, e1']; omega) (by rw [e1]; omega)
      (by rw [e2, e2']; omega)
    ext z
    rcases Nat.lt_or_ge z z0 with hz | hz
    · have := congrArg (Multiset.count z) hl
      have k1 := Multiset.count_filter_of_pos (p := (· < z0)) (s := c) hz
      have k2 := Multiset.count_filter_of_pos (p := (· < z0)) (s := c') hz
      rw [k1, k2] at this
      exact this
    · rcases Nat.lt_or_ge y z with hzy | hzy
      · rw [Multiset.count_eq_zero.2 (fun h => by have := hcy z h; omega),
          Multiset.count_eq_zero.2 (fun h => by have := hcy' z h; omega)]
      · exact hcnt z (Finset.mem_Icc.2 ⟨hz, hzy⟩)
  calc S.card = (S.image φ).card := (Finset.card_image_of_injOn hinj).symm
    _ ≤ (z0 + j).choose j := by
        refine card_le_choose_of_bounded _ z0 j fun d hd => ?_
        obtain ⟨c, hc, rfl⟩ := Finset.mem_image.1 hd
        obtain ⟨hcj, -, -⟩ := hS c hc
        have hle : Multiset.card (c.filter (· < z0)) ≤ j :=
          hcj ▸ Multiset.card_le_card (Multiset.filter_le _ _)
        refine ⟨by simp only [φ, Multiset.card_add, Multiset.card_replicate]; omega, ?_⟩
        intro x hx
        rcases Multiset.mem_add.1 hx with hx | hx
        · have := (Multiset.mem_filter.1 hx).2; omega
        · rw [Multiset.eq_of_mem_replicate hx]

open Classical in
/-- `r(b, c_L)` of Proposition 35.8: the number of multisets `c_S` of `j` digits at most `z`
with `m(c_L) + m(c_S) ≡ 0 (mod b - 1)`, where `m(c) = ∑ g(x) = F(c) - σ(c)`. -/
noncomputable def rCount (m b z j : ℕ) (cL : Multiset ℕ) : ℕ :=
  (((stringsLE z j).image fun s : List ℕ => (s : Multiset ℕ)).filter fun cS =>
    (b - 1) ∣ (cL.map (g m)).sum + (cS.map (g m)).sum).card

/-- The window of Proposition 35.8 for the large part `c_L` and the leading digit `p` of a
`k`-digit solution with digits at most `X`: the bases `2 ≤ b ≤ B` with
`b - 1 < (F(c_L)/p)^(1/(k-1)) < b + (X + 1)/(p (k - 1))`. -/
noncomputable def window358 (m B k X : ℕ) (τ : Multiset ℕ × ℕ) : Finset ℕ := by
  classical
  exact (Finset.Icc 2 B).filter fun b =>
    (b : ℝ) - 1 < ((((τ.1.map (w m)).sum : ℕ) : ℝ) / τ.2) ^ (((k - 1 : ℕ) : ℝ))⁻¹ ∧
    ((((τ.1.map (w m)).sum : ℕ) : ℝ) / τ.2) ^ (((k - 1 : ℕ) : ℝ))⁻¹ <
      b + (X + 1 : ℝ) / (τ.2 * ((k - 1 : ℕ) : ℝ))

/-- **Proposition 35.8** (section 35.4.1), the summed bound. Let `k ≥ 3`, `0^0 = m ≤ 1`, let `X`
bound every digit `x` with `x^x < B^k`, and for each base `b` let `z(b)` be a threshold with
`k z(b)^(z(b)) < b - 1` (in the form `k w(z(b)) < b - 1`); the digits up to `z(b)` are small.
Then the number of bases `b ≤ B` with a `k`-digit solution is at most the sum, over the large
parts `c_L` (multisets of at most `k` digits up to `X`) and the leading digits `p ≤ X`, of
`r(b, c_L)` over the bases `b` of the window of `(c_L, p)`. -/
theorem prop35_8_sum {m B k X : ℕ} (z : ℕ → ℕ) (hk : 3 ≤ k) (hm : m ≤ 1)
    (hX : ∀ x, x ^ x < B ^ k → x ≤ X) (hz : ∀ b ∈ Finset.Icc 2 B, k * w m (z b) < b - 1) :
    (basesWith m B k).card ≤
      ∑ τ ∈ ((Finset.range (k + 1)).biUnion fun j =>
          (stringsLE X j).image fun s : List ℕ => (s : Multiset ℕ)) ×ˢ Finset.Icc 1 X,
        ∑ b ∈ window358 m B k X τ, rCount m b (z b) (k - Multiset.card τ.1) τ.1 := by
  classical
  set T := ((Finset.range (k + 1)).biUnion fun j =>
          (stringsLE X j).image fun s : List ℕ => (s : Multiset ℕ)) ×ˢ Finset.Icc 1 X
  set f : Multiset ℕ × ℕ → ℕ → ℕ := fun τ b =>
    if b ∈ window358 m B k X τ then rCount m b (z b) (k - Multiset.card τ.1) τ.1 else 0
  -- every base with a solution contributes at least 1
  have hone : ∀ b ∈ basesWith m B k, 1 ≤ ∑ τ ∈ T, f τ b := by
    intro b hb
    simp only [basesWith, Finset.mem_filter, Finset.mem_Icc] at hb
    obtain ⟨⟨hb2, hbB⟩, s, hslen, hsol⟩ := hb
    obtain ⟨p, q, t, rfl⟩ : ∃ p q t, s = p :: q :: t := by
      match s, hslen with
      | p :: q :: t, _ => exact ⟨p, q, t, rfl⟩
      | [], h => simp at h; omega
      | [_], h => simp at h; omega
    have ht : t ≠ [] := by rintro rfl; simp at hslen; omega
    have hp1 : 1 ≤ p := by
      have := hsol.head_ne_zero (by simp); simp at this; omega
    have hdig : ∀ d ∈ p :: q :: t, d ≤ X := fun d hd =>
      hX d (by rw [← hslen]; exact hsol.pow_self_lt hb2 hbB hd)
    set s := p :: q :: t with hsdef
    set Lg := s.filter fun x => z b < x
    set Sm := s.filter fun x => ¬ z b < x
    have hperm : s.Perm (Lg ++ Sm) := (List.filter_append_perm _ s).symm
    have hFs : Fs m s = Fs m Lg + Fs m Sm := by
      rw [← Fs_append]; unfold Fs; exact (hperm.map _).sum_eq
    have hlen : Lg.length + Sm.length = k := by rw [← List.length_append, ← hperm.length_eq, hslen]
    -- the small part
    have hSm : Fs m Sm < b - 1 := by
      have h1 : Fs m Sm ≤ Sm.length * w m (z b) := by
        unfold Fs
        have := List.sum_le_length_nsmul (Sm.map (w m)) (w m (z b)) (by
          intro y hy
          obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hy
          have := (List.mem_filter.1 hx).2
          simp only [not_lt] at this
          exact w_le_of_le hm (of_decide_eq_true this))
        simpa using this
      have h2 : Sm.length * w m (z b) ≤ k * w m (z b) := Nat.mul_le_mul_right _ (by omega)
      have := hz b (Finset.mem_Icc.2 ⟨hb2, hbB⟩)
      omega
    -- the congruence
    have hcong :
        (b - 1) ∣ ((Lg : Multiset ℕ).map (g m)).sum + ((Sm : Multiset ℕ).map (g m)).sum := by
      have h := hsol.sum_g_modEq_zero (by omega)
      rw [Multiset.map_coe, Multiset.sum_coe, Multiset.map_coe, Multiset.sum_coe,
        ← List.sum_append, ← List.map_append]
      rw [(hperm.map (g m)).sum_eq] at h
      exact (Nat.modEq_zero_iff_dvd).1 h
    have hτ : ((Lg : Multiset ℕ), p) ∈ T := by
      refine Finset.mem_product.2 ⟨?_, Finset.mem_Icc.2 ⟨hp1, hdig p (by rw [hsdef]; simp)⟩⟩
      simp only [Finset.mem_biUnion, Finset.mem_range, Finset.mem_image]
      exact ⟨Lg.length, by omega, Lg, mem_stringsLE.2 ⟨rfl, fun d hd => hdig d
        (List.mem_of_mem_filter hd)⟩, rfl⟩
    have hwin : b ∈ window358 m B k X ((Lg : Multiset ℕ), p) := by
      have hq : q ≤ X := hdig q (by rw [hsdef]; simp)
      have hF1 : Fs m Lg ≤ P b s := by rw [hsol.eq, hFs]; omega
      have hF2 : P b s < Fs m Lg + b := by rw [hsol.eq, hFs]; omega
      obtain ⟨r1, r2⟩ := prop35_8_root hsol ht hq hF1 hF2
      have hk1 : k - 1 = t.length + 1 := by rw [← hslen, hsdef]; simp
      simp only [window358, Finset.mem_filter, Finset.mem_Icc, Multiset.map_coe,
        Multiset.sum_coe, hk1]
      exact ⟨⟨hb2, hbB⟩, r1, r2⟩
    have hr : 1 ≤ rCount m b (z b) (k - Multiset.card (Lg : Multiset ℕ)) (Lg : Multiset ℕ) := by
      unfold rCount
      apply Finset.card_pos.2
      refine ⟨(Sm : Multiset ℕ), Finset.mem_filter.2 ⟨Finset.mem_image.2 ⟨Sm, ?_, rfl⟩, hcong⟩⟩
      refine mem_stringsLE.2 ⟨by rw [Multiset.coe_card]; omega, fun d hd => ?_⟩
      have := (List.mem_filter.1 hd).2
      simp only [not_lt] at this
      exact of_decide_eq_true this
    calc 1 ≤ f ((Lg : Multiset ℕ), p) b := by simp only [f, hwin, ite_true]; exact hr
      _ ≤ ∑ τ ∈ T, f τ b :=
          Finset.single_le_sum (f := fun τ => f τ b) (fun _ _ => Nat.zero_le _) hτ
  calc (basesWith m B k).card = ∑ _b ∈ basesWith m B k, 1 := by simp
    _ ≤ ∑ b ∈ basesWith m B k, ∑ τ ∈ T, f τ b := Finset.sum_le_sum hone
    _ = ∑ τ ∈ T, ∑ b ∈ basesWith m B k, f τ b := Finset.sum_comm
    _ ≤ ∑ τ ∈ T, ∑ b ∈ window358 m B k X τ, rCount m b (z b) (k - Multiset.card τ.1) τ.1 := by
        apply Finset.sum_le_sum
        intro τ _
        simp only [f]
        rw [Finset.sum_ite_mem]
        exact Finset.sum_le_sum_of_subset (Finset.inter_subset_right)

/-- **Proposition 35.8**, the bound on `r(b, c_L)`: if the small weights stay below `b - 1`
(`j w(z) < b - 1`, `m ≤ 1`), then `m(c_S)` is fixed by `c_L` and `b`, and by Lemma 30.2
`r(b, c_L) ≤ C(z0 + j, j)` for `2 ≤ z0` and `j ≤ 2 z0 + 1`. -/
theorem rCount_le {m b z j z0 : ℕ} (cL : Multiset ℕ) (hm : m ≤ 1)
    (hz : j * w m z < b - 1) (hz0 : 2 ≤ z0) (hj : j ≤ 2 * z0 + 1) :
    rCount m b z j cL ≤ (z0 + j).choose j := by
  classical
  set S := ((stringsLE z j).image fun s : List ℕ => (s : Multiset ℕ)).filter fun cS =>
    (b - 1) ∣ (cL.map (g m)).sum + (cS.map (g m)).sum
  -- `m(c_S) ≤ F(c_S) < b - 1`, so the congruence fixes it
  have hsmall : ∀ cS ∈ S, (cS.map (g m)).sum < b - 1 := by
    intro cS hcS
    obtain ⟨s, hs, rfl⟩ := Finset.mem_image.1 (Finset.mem_filter.1 hcS).1
    obtain ⟨hsl, hsd⟩ := mem_stringsLE.1 hs
    rw [Multiset.map_coe, Multiset.sum_coe]
    have h1 : (s.map (g m)).sum ≤ (s.map (w m)).sum := by
      apply List.sum_le_sum
      intro x _
      exact Nat.sub_le _ _
    have h2 : (s.map (w m)).sum ≤ s.length * w m z := by
      have := List.sum_le_length_nsmul (s.map (w m)) (w m z) (by
        intro y hy
        obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hy
        exact w_le_of_le hm (hsd x hx))
      simpa using this
    rw [hsl] at h2
    omega
  obtain ⟨N, hN⟩ : ∃ N, ∀ cS ∈ S, (cS.map (g m)).sum = N := by
    by_cases hS : S.Nonempty
    · obtain ⟨c0, hc0⟩ := hS
      refine ⟨(c0.map (g m)).sum, fun cS hcS => ?_⟩
      have d1 := (Finset.mem_filter.1 hcS).2
      have d2 := (Finset.mem_filter.1 hc0).2
      have e1 : (cL.map (g m)).sum + (cS.map (g m)).sum ≡ (cL.map (g m)).sum +
          (c0.map (g m)).sum [MOD b - 1] :=
        ((Nat.modEq_zero_iff_dvd.2 d1)).trans (Nat.modEq_zero_iff_dvd.2 d2).symm
      exact Nat.ModEq.eq_of_lt_of_lt (Nat.ModEq.add_left_cancel' _ e1) (hsmall cS hcS)
        (hsmall c0 hc0)
    · exact ⟨0, fun cS hcS => absurd ⟨cS, hcS⟩ hS⟩
  unfold rCount
  refine prop35_8_count (m := m) (y := z) (N := N) hz0 hj S fun cS hcS => ?_
  obtain ⟨s, hs, rfl⟩ := Finset.mem_image.1 (Finset.mem_filter.1 hcS).1
  obtain ⟨hsl, hsd⟩ := mem_stringsLE.1 hs
  exact ⟨by rw [Multiset.coe_card, hsl], fun x hx => hsd x hx, hN _ hcS⟩

section FewLarge

open Real Filter

/-! ### Theorem 35.12: few large digits -/

/-- If every weight of `S` is below `sqrt(b)` and `S` has at most `sqrt(b)` digits, then
`F(S) < b`. -/
lemma Fs_lt_of_sq_lt {b m : ℕ} (hb : 0 < b) (S : List ℕ) (hS : ∀ x ∈ S, w m x ^ 2 < b)
    (hlen : S.length ^ 2 ≤ b) : Fs m S < b := by
  set r := Nat.sqrt (b - 1)
  have hw : ∀ x ∈ S, w m x ≤ r := fun x hx => Nat.le_sqrt'.2 (by have := hS x hx; omega)
  have h1 : Fs m S ≤ S.length * r := by
    unfold Fs
    have := List.sum_le_length_nsmul (S.map (w m)) r (by
      intro y hy
      obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hy
      exact hw x hx)
    simpa using this
  have hr : r * r ≤ b - 1 := Nat.sqrt_le (b - 1)
  have h2 : (S.length * r) * (S.length * r) < b * b := by
    calc (S.length * r) * (S.length * r) = S.length ^ 2 * (r * r) := by ring
      _ ≤ b * (b - 1) := Nat.mul_le_mul hlen hr
      _ < b * b := Nat.mul_lt_mul_of_pos_left (by omega) hb
  have h3 : S.length * r < b := by
    by_contra h
    push Not at h
    have := Nat.mul_le_mul h h
    omega
  omega

/-- `a L^r ≤ e^(c L)` for all large `L`. -/
lemma eventually_rpow_le_exp (r : ℝ) {a c : ℝ} (ha : 0 < a) (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, a * L ^ r ≤ exp (c * L) := by
  have h := (tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero r c hc).eventually
    (gt_mem_nhds (show 0 < 1 / a by positivity))
  filter_upwards [h] with L hL
  have hE := exp_pos (c * L)
  have e : L ^ r * exp (-c * L) * exp (c * L) = L ^ r := by
    rw [mul_assoc, ← exp_add, show -c * L + c * L = 0 by ring, exp_zero, mul_one]
  have h2 : L ^ r < 1 / a * exp (c * L) := by
    rw [← e]; exact mul_lt_mul_of_pos_right hL hE
  have := mul_lt_mul_of_pos_left h2 ha
  rw [← mul_assoc, mul_one_div_cancel ha.ne', one_mul] at this
  exact this.le

open Classical in
/-- The bases `2 ≤ b ≤ B` with a solution of `2 ≤ k ≤ (ln B)^C` digits of which at most
`κ ln B / ln ln B` are large, `w(x)^2 ≥ b` (Theorem 35.12), under `0^0 = m`. -/
noncomputable def fewLargeBases (m : ℕ) (C κ : ℝ) (B : ℕ) : Finset ℕ :=
  (Finset.Icc 2 B).filter fun b => ∃ s : List ℕ, 2 ≤ s.length ∧
    (s.length : ℝ) ≤ log B ^ C ∧
    ((s.filter fun x => b ≤ w m x ^ 2).length : ℝ) ≤ κ * log B / log (log B) ∧ IsSolution b m s

/-- The digit bound of Theorem 35.12: a digit `x` of a solution in base `b ≤ B` with at most
`(ln B)^C` digits has `x ≤ (ln B)^(C+1)`, once `(ln B)^(C+1) ≥ 3`. -/
lemma le_floor_rpow_of_solution {b m B : ℕ} {C : ℝ} {s : List ℕ} (hs : IsSolution b m s)
    (hb : 2 ≤ b) (hbB : b ≤ B) (hlen : (s.length : ℝ) ≤ log B ^ C)
    (h3 : 3 ≤ log (B : ℝ) ^ (C + 1)) {d : ℕ} (hd : d ∈ s) :
    d ≤ ⌊log (B : ℝ) ^ (C + 1)⌋₊ := by
  have hB1 : (1 : ℝ) < B := by exact_mod_cast (show 1 < B by omega)
  have hL0 : 0 < log (B : ℝ) := log_pos hB1
  apply Nat.le_floor
  by_contra hlt
  push Not at hlt
  have hd3 : (3 : ℝ) < d := by linarith
  have hd0 : (0 : ℝ) < d := by linarith
  have h1 : (d : ℝ) * log d < s.length * log B := by
    have := hs.pow_self_lt hb hbB hd
    have : ((d ^ d : ℕ) : ℝ) < ((B ^ s.length : ℕ) : ℝ) := by exact_mod_cast this
    push_cast at this
    have := log_lt_log (by positivity) this
    rwa [log_pow, log_pow] at this
  have h2 : (s.length : ℝ) * log B ≤ log B ^ (C + 1) := by
    rw [rpow_add hL0, rpow_one]
    exact mul_le_mul_of_nonneg_right hlen hL0.le
  have h3' : 1 ≤ log (d : ℝ) := by
    rw [le_log_iff_exp_le hd0]
    have := exp_one_lt_d9
    linarith
  have : (d : ℝ) ≤ d * log d := le_mul_of_one_le_right hd0.le h3'
  linarith

/-- **Theorem 35.12**, for one large `B` (section 35.4.3). Let `L = ln B`, `LL = ln L`,
`C ≥ 1`, `κ, δ > 0`, and suppose that `B ≥ 16`, `ln ln B ≥ 1`, `L^(C+1) ≥ 3`,
`L^(2C) ≤ sqrt(B)`, `κ L / LL ≥ 2`, `κ (1 + log(1 + 2 LL/κ)) ≤ (δ/2) LL`,
`4 (L^(C+1) + 3)^4 ≤ e^(δ L/2)` and `2 ≤ B^δ`. Then at most `B^(max(1/2, C κ) + δ)` bases
`b ≤ B` have a solution of `2 ≤ k ≤ L^C` digits with at most `κ L / LL` large digits. A base
`b > sqrt(B)` with such a solution of `k ≥ 3` digits lies in the window of Proposition 35.8
computed from the large digits `c_L`, the length `k` and the leading digit `p`, because the
small digits add less than `b`. -/
lemma fewLargeBases_card_le {m B : ℕ} {C κ δ : ℝ} (hC : 1 ≤ C) (hκ : 0 < κ) (hδ : 0 < δ)
    (hB : 16 ≤ B) (hLL : max 1 κ ≤ log (log (B : ℝ))) (h3 : 3 ≤ log (B : ℝ) ^ (C + 1))
    (hkb : log (B : ℝ) ^ (2 * C) ≤ sqrt B) (hKr2 : 2 ≤ κ * log B / log (log B))
    (hc1 : κ * (1 + log (1 + 2 * log (log (B : ℝ)) / κ)) ≤ δ / 2 * log (log (B : ℝ)))
    (hc2 : 4 * (log (B : ℝ) ^ (C + 1) + 3) ^ 4 ≤ exp (δ / 2 * log B))
    (hc3 : 2 ≤ (B : ℝ) ^ δ) :
    ((fewLargeBases m C κ B).card : ℝ) ≤ (B : ℝ) ^ (max (1 / 2) (C * κ) + δ) := by
  classical
  set L := log (B : ℝ) with hLdef
  set LL := log L with hLLdef
  have hB1 : (1 : ℝ) < B := by exact_mod_cast (show 1 < B by omega)
  have hB0 : (0 : ℝ) < B := by linarith
  have hL0 : 0 < L := log_pos hB1
  have hLL1 : 1 ≤ LL := (le_max_left _ _).trans hLL
  have hLLκ : κ ≤ LL := (le_max_right _ _).trans hLL
  have hL1 : 1 ≤ L := by
    have := exp_one_le_log hB
    have := add_one_le_exp 1
    linarith
  have hL2 : 2 ≤ L := by
    have := exp_one_le_log hB
    have := exp_one_gt_d9
    linarith
  set Q := L ^ (C + 1) with hQ
  have hQe : Q = L * L ^ C := by rw [hQ, rpow_add hL0, rpow_one, mul_comm]
  have hLC1 : 1 ≤ L ^ C := one_le_rpow hL1 (by linarith)
  have hLQ : L ≤ Q := by rw [hQe]; exact le_mul_of_one_le_right hL0.le hLC1
  have hLCQ : L ^ C ≤ Q := by rw [hQe]; exact le_mul_of_one_le_left (by positivity) hL1
  set X := ⌊Q⌋₊
  set K2 := ⌊L ^ C⌋₊
  set Kr := κ * L / LL with hKr
  set K := ⌊Kr⌋₊
  have hXQ : (X : ℝ) ≤ Q := Nat.floor_le (by positivity)
  have hK2 : (K2 : ℝ) ≤ L ^ C := Nat.floor_le (by positivity)
  have hKKr : (K : ℝ) ≤ Kr := Nat.floor_le (by positivity)
  have hKge : 2 ≤ K := Nat.le_floor (by exact_mod_cast hKr2)
  have hK0 : (0 : ℝ) < K := by
    have : (2 : ℝ) ≤ K := by exact_mod_cast hKge
    linarith
  have hKr_le : Kr ≤ 2 * K := by
    have := Nat.lt_floor_add_one Kr
    have : (2 : ℝ) ≤ K := by exact_mod_cast hKge
    linarith
  have hKL : (K : ℝ) ≤ L := by
    refine hKKr.trans ?_
    rw [hKr, div_le_iff₀ (by linarith)]
    nlinarith
  -- the triples `(c_L, k, p)` and their windows
  set Ms : Finset (Multiset ℕ) :=
    (Finset.range (K + 1)).biUnion fun j => (stringsLE X j).image fun s : List ℕ => (s : Multiset ℕ)
  set Tset := Ms ×ˢ (Finset.Icc 3 K2 ×ˢ Finset.Icc 1 X)
  let Y : Multiset ℕ × ℕ × ℕ → ℝ := fun τ =>
    (((τ.1.map (w m)).sum : ℕ) / (τ.2.2 : ℝ)) ^ (((τ.2.1 - 1 : ℕ) : ℝ))⁻¹
  let fiber : Multiset ℕ × ℕ × ℕ → Finset ℕ := fun τ =>
    (Finset.Icc 2 B).filter fun b => (b : ℝ) - 1 < Y τ ∧
      Y τ < b + (X + 1 : ℝ) / (τ.2.2 * ((τ.2.1 - 1 : ℕ) : ℝ))
  have hfiber : ∀ τ ∈ Tset, ((fiber τ).card : ℝ) ≤ X + 3 := by
    intro τ hτ
    have hτ' := (Finset.mem_product.1 hτ).2
    have hk3 := (Finset.mem_Icc.1 (Finset.mem_product.1 hτ').1).1
    have hp1 := (Finset.mem_Icc.1 (Finset.mem_product.1 hτ').2).1
    set h := (X + 1 : ℝ) / (τ.2.2 * ((τ.2.1 - 1 : ℕ) : ℝ))
    have hden : (1 : ℝ) ≤ τ.2.2 * ((τ.2.1 - 1 : ℕ) : ℝ) := by
      have a1 : (1 : ℝ) ≤ τ.2.2 := by exact_mod_cast hp1
      have a2 : (1 : ℝ) ≤ ((τ.2.1 - 1 : ℕ) : ℝ) := by exact_mod_cast (show 1 ≤ τ.2.1 - 1 by omega)
      nlinarith
    have hh : h ≤ X + 1 := div_le_self (by positivity) hden
    have hh0 : 0 ≤ h := by positivity
    have := card_le_of_window (fiber τ) (r := Y τ + 1) (δ := h + 1) (by linarith) (by
      intro b hb
      have h12 := (Finset.mem_filter.1 hb).2
      constructor <;> linarith [h12.1, h12.2])
    linarith
  -- the containment
  have hsub : fewLargeBases m C κ B ⊆ ((Finset.Icc 2 B).filter fun b => b ^ 2 ≤ B) ∪
      basesWith m B 2 ∪ Tset.biUnion fiber := by
    intro b hb
    simp only [fewLargeBases, Finset.mem_filter, Finset.mem_Icc] at hb
    obtain ⟨⟨hb2, hbB⟩, s, hs2, hslen, hslarge, hsol⟩ := hb
    by_cases hbsq : b ^ 2 ≤ B
    · exact Finset.mem_union_left _ (Finset.mem_union_left _
        (Finset.mem_filter.2 ⟨Finset.mem_Icc.2 ⟨hb2, hbB⟩, hbsq⟩))
    by_cases hlen2 : s.length = 2
    · refine Finset.mem_union_left _ (Finset.mem_union_right _ ?_)
      simp only [basesWith, Finset.mem_filter, Finset.mem_Icc]
      exact ⟨⟨hb2, hbB⟩, s, hlen2, hsol⟩
    apply Finset.mem_union_right
    rw [Finset.mem_biUnion]
    obtain ⟨p, q, t, rfl⟩ : ∃ p q t, s = p :: q :: t := by
      match s, hs2 with
      | p :: q :: t, _ => exact ⟨p, q, t, rfl⟩
    have ht : t ≠ [] := by
      rintro rfl; simp at hlen2
    have hdig : ∀ d ∈ p :: q :: t, d ≤ X :=
      fun d hd => le_floor_rpow_of_solution hsol hb2 hbB hslen h3 hd
    have hp1 : 1 ≤ p := by
      have := hsol.head_ne_zero (by simp); simp at this; omega
    set s := p :: q :: t with hsdef
    set Lg := s.filter fun x => b ≤ w m x ^ 2
    set Sm := s.filter fun x => ¬ b ≤ w m x ^ 2
    have hperm : s.Perm (Lg ++ Sm) := (List.filter_append_perm _ s).symm
    have hFs : Fs m s = Fs m Lg + Fs m Sm := by
      rw [← Fs_append]; unfold Fs; exact (hperm.map _).sum_eq
    -- the small part adds less than `b`
    have hSm : Fs m Sm < b := by
      apply Fs_lt_of_sq_lt (by omega)
      · intro x hx
        have := (List.mem_filter.1 hx).2
        simp only [not_le] at this
        exact of_decide_eq_true this
      · have hle : Sm.length ≤ s.length := List.length_filter_le _ _
        have h1 : ((Sm.length ^ 2 : ℕ) : ℝ) ≤ L ^ (2 * C) := by
          push_cast
          rw [mul_comm, rpow_mul hL0.le, rpow_two]
          exact pow_le_pow_left₀ (by positivity) ((Nat.cast_le.2 hle).trans hslen) 2
        have h2 : sqrt (B : ℝ) < b := by
          rw [sqrt_lt' (by positivity)]
          push Not at hbsq
          exact_mod_cast hbsq
        have : ((Sm.length ^ 2 : ℕ) : ℝ) < b := by linarith
        exact_mod_cast this.le
    refine ⟨((Lg : Multiset ℕ), s.length, p), ?_, ?_⟩
    · refine Finset.mem_product.2 ⟨?_, Finset.mem_product.2 ⟨?_, ?_⟩⟩
      · simp only [Ms, Finset.mem_biUnion, Finset.mem_range, Finset.mem_image]
        refine ⟨Lg.length, ?_, Lg, mem_stringsLE.2 ⟨rfl, fun d hd => hdig d
          (List.mem_of_mem_filter hd)⟩, rfl⟩
        exact Nat.lt_succ_of_le (Nat.le_floor hslarge)
      · refine Finset.mem_Icc.2 ⟨?_, ?_⟩
        · rw [hsdef]; simp only [List.length_cons]
          have := List.length_pos_iff.2 ht; omega
        exact Nat.le_floor hslen
      · exact Finset.mem_Icc.2 ⟨hp1, hdig p (by rw [hsdef]; simp)⟩
    · have hq : q ≤ X := hdig q (by rw [hsdef]; simp)
      have hF1 : Fs m Lg ≤ P b s := by rw [hsol.eq, hFs]; omega
      have hF2 : P b s < Fs m Lg + b := by rw [hsol.eq, hFs]; omega
      obtain ⟨r1, r2⟩ := prop35_8_root hsol ht hq hF1 hF2
      have hlen : s.length - 1 = t.length + 1 := by simp [hsdef]
      have hY : Y ((Lg : Multiset ℕ), s.length, p) =
          ((Fs m Lg : ℝ) / p) ^ ((t.length + 1 : ℕ) : ℝ)⁻¹ := by
        simp only [Y, hlen, Multiset.map_coe, Multiset.sum_coe, Fs]
      simp only [fiber, Finset.mem_filter, Finset.mem_Icc]
      refine ⟨⟨hb2, hbB⟩, ?_, ?_⟩
      · rw [hY]; exact r1
      · rw [hY]
        convert r2 using 3
        simp only [hlen]
  -- counting
  set Cb := (X + K).choose K
  have hMs : (Ms.card : ℝ) ≤ (K + 1) * Cb := by
    have h1 : Ms.card ≤ ∑ j ∈ Finset.range (K + 1),
        ((stringsLE X j).image fun s : List ℕ => (s : Multiset ℕ)).card := Finset.card_biUnion_le
    have h2 : ∀ j ∈ Finset.range (K + 1),
        ((stringsLE X j).image fun s : List ℕ => (s : Multiset ℕ)).card ≤ Cb := by
      intro j hj
      refine (card_multisets_le X j).trans ?_
      change (X + j).choose j ≤ (X + K).choose K
      rw [← Nat.choose_symm_add, ← Nat.choose_symm_add]
      exact Nat.choose_le_choose X (by have := Finset.mem_range.1 hj; omega)
    have h3 := h1.trans (Finset.sum_le_sum h2)
    rw [Finset.sum_const, Finset.card_range, smul_eq_mul] at h3
    exact_mod_cast h3
  have hT : (Tset.card : ℝ) ≤ (K + 1) * Cb * (L ^ C * Q) := by
    have e : Tset.card = Ms.card * ((Finset.Icc 3 K2).card * (Finset.Icc 1 X).card) := by
      simp only [Tset, Finset.card_product]
    rw [e, Nat.card_Icc, Nat.card_Icc]
    push_cast
    have a1 : ((K2 + 1 - 3 : ℕ) : ℝ) ≤ L ^ C := by
      refine le_trans ?_ hK2; exact_mod_cast (show K2 + 1 - 3 ≤ K2 by omega)
    have a2 : ((X + 1 - 1 : ℕ) : ℝ) ≤ Q := by
      refine le_trans ?_ hXQ; exact_mod_cast (show X + 1 - 1 ≤ X by omega)
    exact mul_le_mul hMs (mul_le_mul a1 a2 (by positivity) (by positivity)) (by positivity)
      (by positivity)
  have hsqrt : (((Finset.Icc 2 B).filter fun b => b ^ 2 ≤ B).card : ℝ) ≤ sqrt B := by
    have hs : ((Finset.Icc 2 B).filter fun b => b ^ 2 ≤ B) ⊆ Finset.Icc 1 (Nat.sqrt B) := by
      intro b hb
      obtain ⟨hb1, hb2⟩ := Finset.mem_filter.1 hb
      exact Finset.mem_Icc.2 ⟨by have := (Finset.mem_Icc.1 hb1).1; omega,
        Nat.le_sqrt'.2 hb2⟩
    have := Finset.card_le_card hs
    rw [Nat.card_Icc, Nat.add_sub_cancel] at this
    exact (Nat.cast_le.2 this).trans (Real.nat_sqrt_le_real_sqrt)
  have h2dig : ((basesWith m B 2).card : ℝ) ≤ Q * (Q + 1) := by
    have := prop10_4 (m := m) (B := B) (X := X) le_rfl (fun x hx => by
      apply Nat.le_floor
      by_contra hlt
      push Not at hlt
      have hx3 : (3 : ℝ) < x := by linarith
      have hx0 : (0 : ℝ) < x := by linarith
      have h1 : (x : ℝ) * log x < 2 * L := by
        have : ((x ^ x : ℕ) : ℝ) < ((B ^ 2 : ℕ) : ℝ) := by exact_mod_cast hx
        push_cast at this
        have := log_lt_log (by positivity) this
        rwa [log_pow, log_pow] at this
      have hl1 : 1 ≤ log (x : ℝ) := by
        rw [le_log_iff_exp_le hx0]; have := exp_one_lt_d9; linarith
      have : (x : ℝ) ≤ x * log x := le_mul_of_one_le_right hx0.le hl1
      have h2L : 2 * L ≤ Q := by
        rw [hQe]
        have hLC : L ≤ L ^ C := by
          calc L = L ^ (1 : ℝ) := (rpow_one L).symm
            _ ≤ L ^ C := rpow_le_rpow_of_exponent_le hL1 hC
        rw [mul_comm 2 L]
        exact mul_le_mul_of_nonneg_left (hL2.trans hLC) hL0.le
      linarith)
    calc ((basesWith m B 2).card : ℝ) ≤ ((X * (X + 1) ^ (2 - 1) : ℕ) : ℝ) := by
          exact_mod_cast this
      _ ≤ Q * (Q + 1) := by
          push_cast; simp only [pow_one]
          exact mul_le_mul hXQ (by linarith) (by positivity) (by positivity)
  have hfib : ((Tset.biUnion fiber).card : ℝ) ≤ Tset.card * (Q + 3) := by
    have h1 := Finset.card_biUnion_le (s := Tset) (t := fiber)
    have h1' : ((Tset.biUnion fiber).card : ℝ) ≤ ∑ τ ∈ Tset, ((fiber τ).card : ℝ) := by
      exact_mod_cast h1
    refine h1'.trans ?_
    calc ∑ τ ∈ Tset, ((fiber τ).card : ℝ) ≤ ∑ _τ ∈ Tset, (Q + 3) :=
          Finset.sum_le_sum fun τ hτ => (hfiber τ hτ).trans (by linarith)
      _ = Tset.card * (Q + 3) := by rw [Finset.sum_const, nsmul_eq_mul]
  -- the binomial
  have hCb : (Cb : ℝ) ≤ exp ((C * κ + δ / 2) * L) := by
    have h1 := choose_le_exp (n := X + K) (k := K) (by omega) (by omega)
    refine h1.trans (exp_le_exp.2 ?_)
    have hratio : ((X + K : ℕ) : ℝ) / K ≤ L ^ C * (1 + 2 * LL / κ) := by
      rw [div_le_iff₀ hK0]
      push_cast
      have e1 : Q = Kr * (L ^ C * LL / κ) := by
        rw [hKr, hQe]; field_simp
      have h3 : (X : ℝ) ≤ K * (2 * L ^ C * LL / κ) := by
        calc (X : ℝ) ≤ Q := hXQ
          _ = Kr * (L ^ C * LL / κ) := e1
          _ ≤ (2 * K) * (L ^ C * LL / κ) := mul_le_mul_of_nonneg_right hKr_le (by positivity)
          _ = K * (2 * L ^ C * LL / κ) := by ring
      have h4 : (K : ℝ) ≤ K * L ^ C := le_mul_of_one_le_right hK0.le hLC1
      have : L ^ C * (1 + 2 * LL / κ) * K = K * L ^ C + K * (2 * L ^ C * LL / κ) := by ring
      linarith
    have hlog : log (((X + K : ℕ) : ℝ) / K) ≤ C * LL + log (1 + 2 * LL / κ) := by
      have hpos : 0 < ((X + K : ℕ) : ℝ) / K := by
        apply div_pos _ hK0; exact_mod_cast (show 0 < X + K by omega)
      calc log (((X + K : ℕ) : ℝ) / K) ≤ log (L ^ C * (1 + 2 * LL / κ)) :=
            log_le_log hpos hratio
        _ = C * LL + log (1 + 2 * LL / κ) := by
            rw [log_mul (by positivity) (by positivity), log_rpow hL0]
    have hlog0 : 0 ≤ 1 + C * LL + log (1 + 2 * LL / κ) := by
      have h2 : 0 ≤ 2 * LL / κ := by positivity
      have : 0 ≤ log (1 + 2 * LL / κ) := log_nonneg (by linarith)
      have : 0 ≤ C * LL := by positivity
      linarith
    calc (K : ℝ) * (1 + log (((X + K : ℕ) : ℝ) / K))
        ≤ K * (1 + C * LL + log (1 + 2 * LL / κ)) := by
          apply mul_le_mul_of_nonneg_left _ hK0.le; linarith
      _ ≤ Kr * (1 + C * LL + log (1 + 2 * LL / κ)) := mul_le_mul_of_nonneg_right hKKr hlog0
      _ = C * κ * L + L / LL * (κ * (1 + log (1 + 2 * LL / κ))) := by
          rw [hKr]; field_simp; ring
      _ ≤ C * κ * L + L / LL * (δ / 2 * LL) := by gcongr
      _ = (C * κ + δ / 2) * L := by field_simp
  -- assembling
  have hCb1 : (1 : ℝ) ≤ Cb := by exact_mod_cast Nat.choose_pos (by omega)
  have hpoly : Q * (Q + 1) + (K + 1) * Cb * (L ^ C * Q) * (Q + 3) ≤ Cb * (2 * (Q + 3) ^ 4) := by
    have hQ0 : 0 ≤ Q := by positivity
    have a1 : Q * (Q + 1) ≤ (Q + 3) ^ 4 := by nlinarith
    have a2 : ((K : ℝ) + 1) * (L ^ C * Q) * (Q + 3) ≤ (Q + 3) ^ 4 := by
      have b1 : (K : ℝ) + 1 ≤ Q + 3 := by linarith
      have b2 : L ^ C * Q ≤ (Q + 3) * (Q + 3) :=
        mul_le_mul (by linarith) (by linarith) hQ0 (by positivity)
      calc ((K : ℝ) + 1) * (L ^ C * Q) * (Q + 3) ≤ (Q + 3) * ((Q + 3) * (Q + 3)) * (Q + 3) := by
            gcongr
        _ = (Q + 3) ^ 4 := by ring
    have : Q * (Q + 1) ≤ Cb * (Q + 3) ^ 4 :=
      a1.trans (le_mul_of_one_le_left (by positivity) hCb1)
    have a3 : ((K : ℝ) + 1) * Cb * (L ^ C * Q) * (Q + 3) ≤ Cb * (Q + 3) ^ 4 := by
      calc ((K : ℝ) + 1) * Cb * (L ^ C * Q) * (Q + 3)
          = Cb * (((K : ℝ) + 1) * (L ^ C * Q) * (Q + 3)) := by ring
        _ ≤ Cb * (Q + 3) ^ 4 := mul_le_mul_of_nonneg_left a2 (by positivity)
    linarith
  have hcard : ((fewLargeBases m C κ B).card : ℝ) ≤ sqrt B + Cb * (2 * (Q + 3) ^ 4) := by
    have h1 := Finset.card_le_card hsub
    have h2 := Finset.card_union_le (((Finset.Icc 2 B).filter fun b => b ^ 2 ≤ B) ∪
      basesWith m B 2) (Tset.biUnion fiber)
    have h3 := Finset.card_union_le ((Finset.Icc 2 B).filter fun b => b ^ 2 ≤ B)
      (basesWith m B 2)
    have h : ((fewLargeBases m C κ B).card : ℝ) ≤
        (((Finset.Icc 2 B).filter fun b => b ^ 2 ≤ B).card : ℝ) + (basesWith m B 2).card +
          (Tset.biUnion fiber).card := by exact_mod_cast h1.trans (h2.trans (by omega))
    have hT' : (Tset.card : ℝ) * (Q + 3) ≤ (K + 1) * Cb * (L ^ C * Q) * (Q + 3) :=
      mul_le_mul_of_nonneg_right hT (by positivity)
    linarith
  -- the powers of `B`
  have hBexp : ∀ a : ℝ, (B : ℝ) ^ a = exp (a * L) := fun a => by
    rw [rpow_def_of_pos hB0, mul_comm]
  set a := max (1 / 2) (C * κ) + δ
  have hhalf : 2 * sqrt (B : ℝ) ≤ (B : ℝ) ^ a := by
    have e : sqrt (B : ℝ) = (B : ℝ) ^ (1 / 2 : ℝ) := sqrt_eq_rpow _
    have : (B : ℝ) ^ (1 / 2 + δ) ≤ (B : ℝ) ^ a :=
      rpow_le_rpow_of_exponent_le hB1.le (by simp only [a]; linarith [le_max_left (1 / 2) (C * κ)])
    rw [rpow_add hB0] at this
    rw [e]
    calc 2 * (B : ℝ) ^ (1 / 2 : ℝ) ≤ (B : ℝ) ^ δ * (B : ℝ) ^ (1 / 2 : ℝ) :=
          mul_le_mul_of_nonneg_right hc3 (rpow_nonneg hB0.le _)
      _ = (B : ℝ) ^ (1 / 2 : ℝ) * (B : ℝ) ^ δ := mul_comm _ _
      _ ≤ _ := this
  have hmain : 2 * (Cb * (2 * (Q + 3) ^ 4)) ≤ (B : ℝ) ^ a := by
    have : (B : ℝ) ^ (C * κ + δ) ≤ (B : ℝ) ^ a :=
      rpow_le_rpow_of_exponent_le hB1.le (by simp only [a]; linarith [le_max_right (1 / 2) (C * κ)])
    rw [hBexp] at this
    have e : exp ((C * κ + δ) * L) = exp ((C * κ + δ / 2) * L) * exp (δ / 2 * L) := by
      rw [← exp_add]; ring_nf
    rw [e] at this
    have hQ4 : 0 ≤ 2 * (Q + 3) ^ 4 := by positivity
    calc 2 * (Cb * (2 * (Q + 3) ^ 4)) = Cb * (4 * (Q + 3) ^ 4) := by ring
      _ ≤ exp ((C * κ + δ / 2) * L) * exp (δ / 2 * L) :=
          mul_le_mul hCb hc2 (by positivity) (by positivity)
      _ ≤ _ := this
  linarith

/-- **Theorem 35.12** (section 35.4.3). Fix `C ≥ 1` and `κ, δ > 0`. For all large `B`, at most
`B^(max(1/2, C κ) + δ)` bases `b ≤ B` have a solution of `2 ≤ k ≤ (ln B)^C` digits of which at
most `κ ln B / ln ln B` are large (`w(x)^2 ≥ b`), whatever the number of small digits. With
`κ = 1/C - ε` this is the library's `B^(max(1/2, 1 - C ε) + o(1))`. -/
theorem theorem35_12 (m : ℕ) {C κ δ : ℝ} (hC : 1 ≤ C) (hκ : 0 < κ) (hδ : 0 < δ) :
    ∃ B₀ : ℕ, ∀ B ≥ B₀,
      ((fewLargeBases m C κ B).card : ℝ) ≤ (B : ℝ) ^ (max (1 / 2) (C * κ) + δ) := by
  have hL : Tendsto (fun B : ℕ => log (B : ℝ)) atTop atTop :=
    tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hT : Tendsto (fun B : ℕ => log (log (B : ℝ))) atTop atTop := tendsto_log_atTop.comp hL
  have hKr := tendsto_mul_log_div_log_log hκ
  -- conditions on `L = ln B`
  have e3 : ∀ᶠ L : ℝ in atTop, 3 ≤ L ^ (C + 1) := by
    filter_upwards [eventually_ge_atTop 3] with L hL3
    calc (3 : ℝ) ≤ L := hL3
      _ = L ^ (1 : ℝ) := (rpow_one L).symm
      _ ≤ L ^ (C + 1) := rpow_le_rpow_of_exponent_le (by linarith) (by linarith)
  have ekb : ∀ᶠ L : ℝ in atTop, L ^ (2 * C) ≤ exp (1 / 2 * L) := by
    filter_upwards [eventually_rpow_le_exp (2 * C) one_pos (show (0 : ℝ) < 1 / 2 by norm_num)]
      with L h
    linarith
  have ec2 : ∀ᶠ L : ℝ in atTop, 4 * (L ^ (C + 1) + 3) ^ 4 ≤ exp (δ / 2 * L) := by
    filter_upwards [e3, eventually_ge_atTop 1,
      eventually_rpow_le_exp (4 * (C + 1)) (show (0 : ℝ) < 64 by norm_num)
        (show 0 < δ / 2 by positivity)] with L h3 hL1 h
    have hQ : L ^ (C + 1) + 3 ≤ 2 * L ^ (C + 1) := by linarith
    have hQ4 : (L ^ (C + 1)) ^ 4 = L ^ (4 * (C + 1)) := by
      rw [← rpow_natCast, ← rpow_mul (by linarith)]; ring_nf
    calc 4 * (L ^ (C + 1) + 3) ^ 4 ≤ 4 * (2 * L ^ (C + 1)) ^ 4 := by
          gcongr
      _ = 64 * L ^ (4 * (C + 1)) := by rw [mul_pow, hQ4]; ring
      _ ≤ _ := h
  have ec3 : ∀ᶠ L : ℝ in atTop, 2 ≤ exp (δ * L) := by
    filter_upwards [eventually_ge_atTop (1 / δ)] with L hL
    have : 1 ≤ δ * L := by rwa [div_le_iff₀ hδ, mul_comm] at hL
    linarith [add_one_le_exp (δ * L)]
  obtain ⟨B₀, hB₀⟩ := eventually_atTop.1 ((hT.eventually_ge_atTop (max 1 κ)).and
    ((hKr.eventually_ge_atTop 2).and ((hT.eventually (eventually_log_cond hκ hδ)).and
      ((hL.eventually (e3.and (ekb.and (ec2.and ec3)))).and (eventually_ge_atTop 16)))))
  refine ⟨B₀, fun B hB => ?_⟩
  obtain ⟨h1, h2, h3, ⟨h4, h5, h6, h7⟩, h8⟩ := hB₀ B hB
  have hB0 : (0 : ℝ) < B := by exact_mod_cast (show 0 < B by omega)
  refine fewLargeBases_card_le hC hκ hδ h8 h1 h4 ?_ h2 h3 h6 ?_
  · rw [sqrt_eq_rpow, rpow_def_of_pos hB0]
    convert h5 using 2; ring
  · rw [rpow_def_of_pos hB0]
    convert h7 using 2; ring

open Classical in
/-- The bases `2 ≤ b ≤ B` with a solution of `2 ≤ k ≤ (ln b)^C` digits of which at most
`κ ln b / ln ln b` are large (`w(x)^2 ≥ b`), under `0^0 = m`. -/
noncomputable def fewLargeBases' (m : ℕ) (C κ : ℝ) (B : ℕ) : Finset ℕ :=
  (Finset.Icc 2 B).filter fun b => ∃ s : List ℕ, 2 ≤ s.length ∧
    (s.length : ℝ) ≤ log b ^ C ∧
    ((s.filter fun x => b ≤ w m x ^ 2).length : ℝ) ≤ κ * log b / log (log b) ∧ IsSolution b m s

/-- **Theorem 35.12**, the density statement. For `C ≥ 1` and `0 < κ < 1/C`, almost all bases
`b` have no solution of length at most `(ln b)^C` with at most `κ ln b / ln ln b` digits of
weight at least `sqrt(b)`, whatever the number of smaller digits. -/
theorem theorem35_12_density (m : ℕ) {C κ : ℝ} (hC : 1 ≤ C) (hκ : 0 < κ) (hCκ : C * κ < 1) :
    Tendsto (fun B : ℕ => ((fewLargeBases' m C κ B).card : ℝ) / B) atTop (nhds 0) := by
  classical
  set a := max (1 / 2) (C * κ)
  have ha : a < 1 := max_lt (by norm_num) hCκ
  set δ := (1 - a) / 2 with hδ
  have hδ0 : 0 < δ := by linarith
  obtain ⟨B₀, hB₀⟩ := theorem35_12 m hC hκ hδ0
  have hsub : ∀ B, fewLargeBases' m C κ B ⊆ fewLargeBases m C κ B ∪ Finset.Icc 2 15 := by
    intro B b hb
    simp only [fewLargeBases', Finset.mem_filter, Finset.mem_Icc] at hb
    obtain ⟨⟨hb2, hbB⟩, s, hs2, hslen, hsl, hsol⟩ := hb
    by_cases hb15 : b ≤ 15
    · exact Finset.mem_union_right _ (Finset.mem_Icc.2 ⟨hb2, hb15⟩)
    apply Finset.mem_union_left
    simp only [fewLargeBases, Finset.mem_filter, Finset.mem_Icc]
    have hb0 : (0 : ℝ) < b := by exact_mod_cast (show 0 < b by omega)
    have hbB' : (b : ℝ) ≤ B := by exact_mod_cast hbB
    refine ⟨⟨hb2, hbB⟩, s, hs2, ?_, ?_, hsol⟩
    · refine hslen.trans (rpow_le_rpow (log_nonneg (by exact_mod_cast (show 1 ≤ b by omega)))
        (log_le_log hb0 hbB') (by linarith))
    · refine hsl.trans ?_
      have hmono : log b / log (log b) ≤ log B / log (log B) :=
        div_log_le_div_log (exp_one_le_log (by omega)) (log_le_log hb0 hbB')
      calc κ * log b / log (log b) = κ * (log b / log (log b)) := by ring
        _ ≤ κ * (log B / log (log B)) := mul_le_mul_of_nonneg_left hmono hκ.le
        _ = κ * log B / log (log B) := by ring
  have hlim : Tendsto (fun B : ℕ => (B : ℝ) ^ (a + δ - 1) + 14 / B) atTop (nhds 0) := by
    have h1 : Tendsto (fun B : ℕ => (B : ℝ) ^ (a + δ - 1)) atTop (nhds 0) :=
      (tendsto_rpow_neg_atTop (show 0 < 1 - (a + δ) by linarith)).comp
        tendsto_natCast_atTop_atTop |>.congr' (by
          filter_upwards with B
          simp only [Function.comp_apply, neg_sub])
    have h2 : Tendsto (fun B : ℕ => (14 : ℝ) / B) atTop (nhds 0) :=
      tendsto_const_div_atTop_nhds_zero_nat 14
    simpa using h1.add h2
  refine squeeze_zero' (Eventually.of_forall fun B => by positivity) ?_ hlim
  filter_upwards [eventually_ge_atTop (max B₀ 1)] with B hB
  have hB1 : (1 : ℝ) ≤ B := by exact_mod_cast (le_max_right _ _).trans hB
  have hB0 : (0 : ℝ) < B := by linarith
  have hc := Finset.card_le_card (hsub B)
  have hc2 := Finset.card_union_le (fewLargeBases m C κ B) (Finset.Icc 2 15)
  have hcR : ((fewLargeBases' m C κ B).card : ℝ) ≤ (fewLargeBases m C κ B).card + 14 := by
    have : (Finset.Icc 2 15).card = 14 := by simp
    exact_mod_cast hc.trans (hc2.trans (by omega))
  rw [div_le_iff₀ hB0, add_mul, div_mul_cancel₀ _ hB0.ne']
  have := hB₀ B ((le_max_left _ _).trans hB)
  have e : (B : ℝ) ^ (a + δ - 1) * B = (B : ℝ) ^ (a + δ) := by
    rw [rpow_sub hB0, rpow_one, div_mul_cancel₀ _ hB0.ne']
  rw [e]
  linarith

end FewLarge

/-! ### Proposition 35.9 -/

/-- **Proposition 35.9** (section 35.4.2), the exact share. Among the multisets of `K` digits from
`0..X`, the share of those with no digit below `a` (`a = z + 1 ≤ X`) is
`C(X - a + K, K) / C(X + K, K) = prod over i < K of (X - a + 1 + i) / (X + 1 + i)`. -/
theorem prop35_9_share {X a : ℕ} (ha : a ≤ X) (K : ℕ) :
    ((X - a + K).choose K : ℝ) / ((X + K).choose K) =
      ∏ i ∈ Finset.range K, ((X - a + 1 + i : ℝ) / (X + 1 + i)) := by
  induction K with
  | zero => simp
  | succ K ih =>
    rw [Finset.prod_range_succ, ← ih]
    have e1 := Nat.add_one_mul_choose_eq (X - a + K) K
    have e2 := Nat.add_one_mul_choose_eq (X + K) K
    rw [show X - a + K + 1 = X - a + (K + 1) by ring] at e1
    rw [show X + K + 1 = X + (K + 1) by ring] at e2
    have h1 : ((X - a + (K + 1)).choose (K + 1) : ℝ) =
        ((X - a + K).choose K : ℝ) * (X - a + 1 + K) / (K + 1) := by
      have : ((X - a + K + 1 : ℕ) : ℝ) * ((X - a + K).choose K : ℝ) =
          ((X - a + (K + 1)).choose (K + 1) : ℝ) * (K + 1 : ℕ) := by exact_mod_cast e1
      field_simp
      push_cast [Nat.cast_sub ha] at this
      linarith
    have h2 : ((X + (K + 1)).choose (K + 1) : ℝ) =
        ((X + K).choose K : ℝ) * (X + 1 + K) / (K + 1) := by
      have : ((X + K + 1 : ℕ) : ℝ) * ((X + K).choose K : ℝ) =
          ((X + (K + 1)).choose (K + 1) : ℝ) * (K + 1 : ℕ) := by exact_mod_cast e2
      field_simp
      push_cast at this ⊢
      linarith
    have hpos : (0 : ℝ) < ((X + K).choose K : ℝ) :=
      by exact_mod_cast Nat.choose_pos (by omega)
    rw [h1, h2]
    field_simp

/-- **Proposition 35.9** (section 35.4.2), the bounds: the share lies between
`exp(-K a / (X - a + 1))` and `exp(-K a / (X + K))`, `a = z + 1`. -/
theorem prop35_9_bounds {X a : ℕ} (ha : a ≤ X) (K : ℕ) :
    Real.exp (-(K * a / (X - a + 1 : ℝ))) ≤
        ∏ i ∈ Finset.range K, ((X - a + 1 + i : ℝ) / (X + 1 + i)) ∧
      ∏ i ∈ Finset.range K, ((X - a + 1 + i : ℝ) / (X + 1 + i)) ≤
        Real.exp (-(K * a / (X + K : ℝ))) := by
  have hXa : (a : ℝ) ≤ X := by exact_mod_cast ha
  have ha0 : (0 : ℝ) ≤ a := Nat.cast_nonneg a
  constructor
  · have : Real.exp (-(K * a / (X - a + 1 : ℝ))) =
        ∏ i ∈ Finset.range K, Real.exp (-(a / (X - a + 1 : ℝ))) := by
      rw [Finset.prod_const, Finset.card_range, ← Real.exp_nat_mul]; ring_nf
    rw [this]
    apply Finset.prod_le_prod₀ (fun _ _ => (Real.exp_pos _).le)
    intro i _
    have hi : (0 : ℝ) ≤ i := Nat.cast_nonneg i
    have hd : (0 : ℝ) < X - a + 1 + i := by linarith
    -- `exp(-t/(1-t)) ≤ 1 - t` with `1 - t = (X - a + 1 + i)/(X + 1 + i)`
    have h1 : Real.exp (-(a / (X - a + 1 : ℝ))) ≤ Real.exp (-(a / (X - a + 1 + i : ℝ))) := by
      apply Real.exp_le_exp.2
      rw [neg_le_neg_iff]
      exact div_le_div_of_nonneg_left ha0 (by linarith) (by linarith)
    refine h1.trans ?_
    have h2 := Real.add_one_le_exp (a / (X - a + 1 + i : ℝ))
    have h3 : Real.exp (-(a / (X - a + 1 + i : ℝ))) = 1 / Real.exp (a / (X - a + 1 + i : ℝ)) := by
      rw [Real.exp_neg, one_div]
    rw [h3, div_le_div_iff₀ (Real.exp_pos _) (by linarith)]
    have h4 : (X + 1 + i : ℝ) = (X - a + 1 + i) * (a / (X - a + 1 + i) + 1) := by
      field_simp; ring
    rw [one_mul, h4]
    exact mul_le_mul_of_nonneg_left h2 hd.le
  · have : Real.exp (-(K * a / (X + K : ℝ))) =
        ∏ i ∈ Finset.range K, Real.exp (-(a / (X + K : ℝ))) := by
      rw [Finset.prod_const, Finset.card_range, ← Real.exp_nat_mul]; ring_nf
    rw [this]
    apply Finset.prod_le_prod₀
    · intro i _
      have hi : (0 : ℝ) ≤ i := Nat.cast_nonneg i
      exact div_nonneg (by linarith) (by linarith)
    intro i hi
    have hiK : (i : ℝ) + 1 ≤ K := by exact_mod_cast Finset.mem_range.1 hi
    have hi0 : (0 : ℝ) ≤ i := Nat.cast_nonneg i
    have hd : (0 : ℝ) < X + 1 + i := by linarith
    have e : (X - a + 1 + i : ℝ) / (X + 1 + i) = 1 + (-(a / (X + 1 + i))) := by
      field_simp; ring
    rw [e]
    calc 1 + -((a : ℝ) / (X + 1 + i)) = -((a : ℝ) / (X + 1 + i)) + 1 := by ring
      _ ≤ Real.exp (-((a : ℝ) / (X + 1 + i))) := Real.add_one_le_exp _
      _ ≤ Real.exp (-((a : ℝ) / (X + K))) :=
          Real.exp_le_exp.2 (neg_le_neg (div_le_div_of_nonneg_left ha0 hd (by linarith)))

/-! ### Theorem 35.13: the last step -/

/-- Strings of equal length with digits below `b` have equal values only if they are equal. -/
lemma P_inj_of_length_eq {b : ℕ} (hb : 2 ≤ b) {s t : List ℕ} (hl : s.length = t.length)
    (hs : ∀ d ∈ s, d < b) (ht : ∀ d ∈ t, d < b) (h : P b s = P b t) : s = t := by
  have := Nat.ofDigits_inj_of_len_eq (L1 := s.reverse) (L2 := t.reverse) (by omega)
    (by simpa using hl) (by simpa using hs) (by simpa using ht) h
  simpa using this

/-- No carry: adding `E < b^k` to a number whose digit at position `k` is at most `b - 2`
does not change its digits above `k`. -/
lemma div_add_eq_of_digit_le {b k Y E : ℕ} (hb : 2 ≤ b) (hdig : (Y / b ^ k) % b ≤ b - 2)
    (hE : E < b ^ k) : (Y + E) / b ^ (k + 1) = Y / b ^ (k + 1) := by
  have hbk : 0 < b ^ k := pow_pos (by omega) k
  have h1 : Y % b ^ (k + 1) = (Y / b ^ k) % b * b ^ k + Y % b ^ k := by
    rw [pow_succ, Nat.mod_mul]
    ring
  have h2 : Y % b ^ k < b ^ k := Nat.mod_lt _ hbk
  have h3 : Y % b ^ (k + 1) + E < b ^ (k + 1) := by
    rw [h1, pow_succ]
    have : (Y / b ^ k) % b * b ^ k ≤ (b - 2) * b ^ k := Nat.mul_le_mul_right _ hdig
    have : (b - 2) * b ^ k + 2 * b ^ k = b ^ k * b := by
      rw [← Nat.add_mul, Nat.sub_add_cancel hb, mul_comm]
    omega
  have hpos : 0 < b ^ (k + 1) := pow_pos (by omega) _
  conv_lhs => rw [← Nat.div_add_mod Y (b ^ (k + 1))]
  rw [add_assoc, Nat.mul_add_div hpos, Nat.div_eq_of_lt h3, add_zero]

/-- **Theorem 35.13** (section 35.5.1), Step 3. Let `n` be the string `A` (the top digits)
followed by `k + 1` further digits, and suppose `F(n) = Y + E` where the top digits of `Y`
above position `k` are `A`, the digit of `Y` at position `k` is at most `b - 2`, and
`E < b^k`. Then `n` and `F(n)` agree above position `k`, so `|n - F(n)| < b^(k+1)`. -/
theorem theorem35_13_step3 {b k Y E Fn : ℕ} (hb : 2 ≤ b) {A Rest : List ℕ}
    (hRest : Rest.length = k + 1) (hdR : ∀ d ∈ Rest, d < b)
    (hYA : Y / b ^ (k + 1) = P b A) (hdig : (Y / b ^ k) % b ≤ b - 2) (hE : E < b ^ k)
    (hF : Fn = Y + E) :
    |((P b (A ++ Rest) : ℕ) : ℤ) - Fn| < b ^ (k + 1) := by
  have hpos : 0 < b ^ (k + 1) := pow_pos (by omega) _
  have hn : P b (A ++ Rest) = P b A * b ^ (k + 1) + P b Rest := by
    rw [P_append, hRest]; ring
  have hR : P b Rest < b ^ (k + 1) := hRest ▸ P_lt_pow (by omega) hdR
  have hFdiv : Fn / b ^ (k + 1) = P b A := by rw [hF, div_add_eq_of_digit_le hb hdig hE, hYA]
  have hF1 := Nat.div_add_mod Fn (b ^ (k + 1))
  have hF2 := Nat.mod_lt Fn hpos
  rw [hFdiv] at hF1
  have e1 : (Fn : ℤ) = (b : ℤ) ^ (k + 1) * (P b A : ℕ) + (Fn % b ^ (k + 1) : ℕ) := by
    exact_mod_cast hF1.symm
  have e2 : ((P b (A ++ Rest) : ℕ) : ℤ) = (P b A : ℕ) * (b : ℤ) ^ (k + 1) + (P b Rest : ℕ) := by
    exact_mod_cast hn
  have e3 : ((Fn % b ^ (k + 1) : ℕ) : ℤ) < (b : ℤ) ^ (k + 1) := by exact_mod_cast hF2
  have e4 : ((P b Rest : ℕ) : ℤ) < (b : ℤ) ^ (k + 1) := by exact_mod_cast hR
  have e5 : (0 : ℤ) ≤ ((Fn % b ^ (k + 1) : ℕ) : ℤ) := Nat.cast_nonneg _
  have e6 : (0 : ℤ) ≤ ((P b Rest : ℕ) : ℤ) := Nat.cast_nonneg _
  rw [abs_lt, e2, e1]
  constructor <;> linarith

/-- **Theorem 35.13** (section 35.5.1), the last remark. If the string `A ++ Rest` is a solution
of `F`, a different arrangement `Rest'` of the lower digits gives a strict near-solution:
`0 < |n' - F(n')| < b^(k+1)`, since `F` depends only on the multiset. -/
theorem theorem35_13_strict {b k m : ℕ} (hb : 2 ≤ b) {A Rest Rest' : List ℕ}
    (hRest : Rest.length = k + 1) (hdR : ∀ d ∈ Rest, d < b) (hperm : Rest.Perm Rest')
    (hne : Rest ≠ Rest') (hsol : P b (A ++ Rest) = Fs m (A ++ Rest)) :
    0 < |((P b (A ++ Rest') : ℕ) : ℤ) - Fs m (A ++ Rest')| ∧
      |((P b (A ++ Rest') : ℕ) : ℤ) - Fs m (A ++ Rest')| < b ^ (k + 1) := by
  have hF : Fs m (A ++ Rest') = Fs m (A ++ Rest) := by
    simp only [Fs, List.map_append, List.sum_append, (hperm.map (w m)).sum_eq]
  have hl' : Rest'.length = k + 1 := hperm.length_eq ▸ hRest
  have hdR' : ∀ d ∈ Rest', d < b := fun d hd => hdR d (hperm.symm.subset hd)
  have hn : ∀ L : List ℕ, L.length = k + 1 → P b (A ++ L) = P b A * b ^ (k + 1) + P b L :=
    fun L hL => by rw [P_append, hL]; ring
  have hR : P b Rest < b ^ (k + 1) := hRest ▸ P_lt_pow (by omega) hdR
  have hR' : P b Rest' < b ^ (k + 1) := hl' ▸ P_lt_pow (by omega) hdR'
  have hneq : P b Rest ≠ P b Rest' := fun h =>
    hne (P_inj_of_length_eq hb (by rw [hRest, hl']) hdR hdR' h)
  rw [hF, ← hsol, hn _ hl', hn _ hRest]
  have h1 : P (b : ℤ) Rest < (b : ℤ) ^ (k + 1) := by exact_mod_cast hR
  have h2 : P (b : ℤ) Rest' < (b : ℤ) ^ (k + 1) := by exact_mod_cast hR'
  have h3 : (0 : ℤ) ≤ P (b : ℤ) Rest := by exact_mod_cast Nat.zero_le _
  have h4 : (0 : ℤ) ≤ P (b : ℤ) Rest' := by exact_mod_cast Nat.zero_le _
  have hneqZ : P (b : ℤ) Rest' ≠ P (b : ℤ) Rest := by exact_mod_cast hneq.symm
  push_cast
  constructor
  · apply abs_pos.2
    intro h; apply hneqZ; linarith
  · rw [abs_lt]
    constructor <;> linarith

/-! ### Theorem 35.13: Steps 1 and 2 -/

/-- `(x + 1)^x ≤ e x^x`, from `1 + 1/x ≤ e^(1/x)`. -/
lemma add_one_pow_le_exp_mul {x : ℕ} (hx : 1 ≤ x) :
    ((x : ℝ) + 1) ^ x ≤ Real.exp 1 * (x : ℝ) ^ x := by
  have hx0 : (0 : ℝ) < x := by exact_mod_cast hx
  have h1 : (x : ℝ) + 1 = x * (1 + 1 / x) := by field_simp
  have h2 : 1 + 1 / (x : ℝ) ≤ Real.exp (1 / x) := by
    have := Real.add_one_le_exp (1 / (x : ℝ)); linarith
  have h3 : (1 + 1 / (x : ℝ)) ^ x ≤ Real.exp 1 := by
    calc (1 + 1 / (x : ℝ)) ^ x ≤ Real.exp (1 / x) ^ x :=
          pow_le_pow_left₀ (by positivity) h2 x
      _ = Real.exp 1 := by rw [← Real.exp_nat_mul]; congr 1; field_simp
  rw [h1, mul_pow, mul_comm (Real.exp 1)]
  exact mul_le_mul_of_nonneg_left h3 (by positivity)

/-- The steering digit (Step 2 of Theorem 35.13): for `1 ≤ M ≤ b^(b-1)` there is a digit
`1 ≤ x < b` with `x^x ≤ M ≤ e b x^x`. It is the largest `x < b` with `x^x ≤ M`. -/
lemma exists_steer_digit {b M : ℕ} (hb : 2 ≤ b) (hM1 : 1 ≤ M) (hMb : M ≤ b ^ (b - 1)) :
    ∃ x, 1 ≤ x ∧ x < b ∧ x ^ x ≤ M ∧ (M : ℝ) ≤ Real.exp 1 * b * (x : ℝ) ^ x := by
  classical
  set x := Nat.findGreatest (fun x => x ^ x ≤ M) (b - 1) with hxdef
  have hx1 : 1 ≤ x := Nat.le_findGreatest (by omega) (by simpa using hM1)
  have hxb : x ≤ b - 1 := Nat.findGreatest_le _
  have hxM : x ^ x ≤ M :=
    Nat.findGreatest_spec (P := fun x => x ^ x ≤ M) (m := 1) (by omega) (by simpa using hM1)
  refine ⟨x, hx1, by omega, hxM, ?_⟩
  have hbr : (2 : ℝ) ≤ b := by exact_mod_cast hb
  rcases Nat.lt_or_ge x (b - 1) with hlt | hge
  · have hgt : M < (x + 1) ^ (x + 1) := by
      have := Nat.findGreatest_is_greatest (P := fun x => x ^ x ≤ M) (lt_add_one x)
        (by omega)
      simpa using this
    have h1 : ((x : ℝ) + 1) ^ (x + 1) ≤ b * (Real.exp 1 * (x : ℝ) ^ x) := by
      rw [pow_succ, mul_comm]
      have hxb' : (x : ℝ) + 1 ≤ b := by exact_mod_cast (show x + 1 ≤ b by omega)
      exact mul_le_mul hxb' (add_one_pow_le_exp_mul hx1) (by positivity) (by positivity)
    have : (M : ℝ) < ((x : ℝ) + 1) ^ (x + 1) := by exact_mod_cast hgt
    nlinarith
  · have hx : x = b - 1 := by omega
    have h1 := add_one_pow_le_exp_mul (x := b - 1) (by omega)
    have hc : ((b - 1 : ℕ) : ℝ) + 1 = b := by
      rw [Nat.cast_sub (by omega)]; push_cast; ring
    rw [hc] at h1
    have hM : (M : ℝ) ≤ (b : ℝ) ^ (b - 1) := by exact_mod_cast hMb
    rw [hx]
    have : (0 : ℝ) ≤ Real.exp 1 * ((b - 1 : ℕ) : ℝ) ^ (b - 1) := by positivity
    nlinarith

/-- One steering step (Step 2 of Theorem 35.13), for a place value `P` and a zone of the top
`z` digit values. If one copy adds `v ≤ (b - z - 1) P`, then some number `c` of copies, with
`c v < z P + v`, puts the digit at `P` below `b - z` and raises the part above it by at most 1.
The three cases of the library are one argument: stop at the first copy after which the part
`N = ⌊F / P⌋` reaches the next multiple of `b`; one copy raises `N` by at most `b - z - 1`. -/
lemma steer {b z P v : ℕ} (Y : ℕ) (hP : 0 < P) (hv : 1 ≤ v) (hz : 1 ≤ z) (hzb : z < b)
    (hvP : v ≤ (b - z - 1) * P) :
    ∃ c, c * v < z * P + v ∧ (Y + c * v) / P % b < b - z ∧
      Y / P / b ≤ (Y + c * v) / P / b ∧ (Y + c * v) / P / b ≤ Y / P / b + 1 := by
  have hb : 0 < b := by omega
  set n0 := Y / P with hn0
  by_cases hr : n0 % b < b - z
  · exact ⟨0, by nlinarith, by simpa using hr, by simp [hn0], by simp [hn0]⟩
  push Not at hr
  have hdm := Nat.div_add_mod n0 b
  have hml := Nat.mod_lt n0 hb
  set M := (n0 / b + 1) * b with hM
  have hMz : M ≤ n0 + z := by
    have : M = b * (n0 / b) + b := by rw [hM]; ring
    omega
  have hMn : n0 < M := by
    have : M = b * (n0 / b) + b := by rw [hM]; ring
    omega
  -- the ceiling of `z P / v` copies suffice
  obtain ⟨W, hW⟩ : ∃ W, W = z * P + v - 1 := ⟨_, rfl⟩
  have hd := Nat.div_add_mod W v
  have hm := Nat.mod_lt W (show 0 < v by omega)
  set c1 := W / v
  have hc1v : c1 * v ≤ z * P + v - 1 := by rw [mul_comm]; omega
  have hzc1 : z * P ≤ c1 * v := by rw [Nat.mul_comm c1 v]; omega
  have hzP : (Y + z * P) / P = n0 + z := by rw [Nat.add_mul_div_right _ _ hP]
  have hc1 : M ≤ (Y + c1 * v) / P := by
    have : (Y + z * P) / P ≤ (Y + c1 * v) / P := Nat.div_le_div_right (by omega)
    omega
  have hex : ∃ c, M ≤ (Y + c * v) / P := ⟨c1, hc1⟩
  classical
  set c := Nat.find hex
  have hc : M ≤ (Y + c * v) / P := Nat.find_spec hex
  have hcc1 : c ≤ c1 := Nat.find_min' hex hc1
  have hc0 : c ≠ 0 := by
    intro h0
    rw [h0, zero_mul, add_zero] at hc
    omega
  have hprev : (Y + (c - 1) * v) / P < M := by
    have := Nat.find_min hex (show c - 1 < c by omega)
    push Not at this
    exact this
  have hstep : (Y + c * v) / P ≤ (Y + (c - 1) * v) / P + (b - z - 1) := by
    have e : Y + c * v = (Y + (c - 1) * v) + v := by
      conv_lhs => rw [show c = (c - 1) + 1 by omega]
      ring
    rw [e]
    calc (Y + (c - 1) * v + v) / P ≤ (Y + (c - 1) * v + (b - z - 1) * P) / P :=
          Nat.div_le_div_right (by omega)
      _ = (Y + (c - 1) * v) / P + (b - z - 1) := Nat.add_mul_div_right _ _ hP
  set N' := (Y + c * v) / P with hN'
  have hN'2 : N' - M < b := by omega
  have e : N' = (N' - M) + b * (n0 / b + 1) := by
    rw [show b * (n0 / b + 1) = M by rw [hM, mul_comm]]; omega
  have hdiv : N' / b = n0 / b + 1 := by
    conv_lhs => rw [e]
    rw [Nat.add_mul_div_left _ _ hb, Nat.div_eq_of_lt hN'2, zero_add]
  have hmod : N' % b = N' - M := by
    conv_lhs => rw [e]
    rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hN'2]
  refine ⟨c, ?_, ?_, ?_, ?_⟩
  · calc c * v ≤ c1 * v := Nat.mul_le_mul_right _ hcc1
      _ < z * P + v := by omega
  · rw [hmod]; omega
  · rw [hdiv]; omega
  · rw [hdiv]

/-- Splitting a quotient by a power of `b` (positions of the digits of Theorem 35.13). -/
lemma div_pow_sub_eq {Y b n i k : ℕ} (hik : i ≤ k) (hkn : k ≤ n) :
    Y / b ^ (n - i) = Y / b ^ (n - k) / b ^ (k - i) := by
  rw [Nat.div_div_eq_div_mul, ← pow_add]
  congr 2
  omega

/-- No carry: if the part `N` of `Y` above a position has last digit below `X ≤ b - 1` and
`N ≤ N' ≤ N + 1`, then `N'` has the same higher part and last digit at most `X`. -/
lemma no_carry {b X N N' : ℕ} (hb0 : 0 < b) (hX : X ≤ b - 1) (hN : N % b < X)
    (h1 : N ≤ N') (h2 : N' ≤ N + 1) : N' / b = N / b ∧ N' % b ≤ X := by
  have hd := Nat.div_add_mod N b
  have e : N' = (N' - b * (N / b)) + b * (N / b) := by omega
  have hlt : N' - b * (N / b) < b := by omega
  constructor
  · rw [e, Nat.add_mul_div_left _ _ hb0, Nat.div_eq_of_lt hlt, zero_add]
  · conv_lhs => rw [e]
    rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hlt]
    omega

/-- If `Y` and `Y'` agree above position `j - 1` (`⌊Y / b^(b-j)⌋`), they agree above every
position `i < j`, and both are below `b^(b-1)` together. -/
lemma div_succ_eq_of_div_eq {b j Y Y' : ℕ} (hj : 1 ≤ j) (hjb : j + 2 ≤ b)
    (hq : Y' / b ^ (b - 1 - j) / b = Y / b ^ (b - 1 - j) / b) :
    Y' / b ^ (b - 1) = Y / b ^ (b - 1) ∧
      ∀ i, i < j → Y' / b ^ (b - 1 - i) % b = Y / b ^ (b - 1 - i) % b := by
  have key : ∀ Z i, i < j → Z / b ^ (b - 1 - i) = Z / b ^ (b - 1 - j) / b / b ^ (j - 1 - i) := by
    intro Z i hi
    rw [div_pow_sub_eq (k := j) (by omega) (by omega), show j - i = 1 + (j - 1 - i) by omega,
      pow_add, pow_one, ← Nat.div_div_eq_div_mul]
  constructor
  · have h1 := key Y' 0 (by omega)
    have h2 := key Y 0 (by omega)
    simp only [Nat.sub_zero] at h1 h2
    rw [h1, h2, hq]
  · intro i hi
    rw [key Y' i hi, key Y i hi, hq]

/-- One step of Step 2 of Theorem 35.13 at position `j + 1` (place value `b^(b-2-j)`), with a
zone of the values at least `Xn`. If digits `1, ..., j - 1` of `Y` are at most `X`, digit `j`
is below `X` and `Y < b^(b-1)`, then copies of one digit `x` keep `Y < b^(b-1)`, make digits
`1, ..., j` at most `X` and digit `j + 1` below `Xn`; there are at most
`e (b - Xn) b / (Xn - 1) + 1` copies. -/
lemma steer_step {b X Xn j Y : ℕ} (hb : 3 ≤ b) (hj : 1 ≤ j) (hjb : j + 2 ≤ b)
    (hX : X ≤ b - 1) (hXn : 2 ≤ Xn) (hXnb : Xn ≤ b - 1)
    (h0 : Y / b ^ (b - 1) = 0) (hlow : ∀ i, 1 ≤ i → i < j → Y / b ^ (b - 1 - i) % b ≤ X)
    (hj' : Y / b ^ (b - 1 - j) % b < X) :
    ∃ x c : ℕ, 1 ≤ x ∧ x < b ∧ (c : ℝ) ≤ Real.exp 1 * (b - Xn) * b / (Xn - 1) + 1 ∧
      (Y + c * x ^ x) / b ^ (b - 1) = 0 ∧
      (∀ i, 1 ≤ i → i ≤ j → (Y + c * x ^ x) / b ^ (b - 1 - i) % b ≤ X) ∧
      (Y + c * x ^ x) / b ^ (b - 1 - (j + 1)) % b < Xn := by
  set P := b ^ (b - 1 - (j + 1)) with hPdef
  have hb0 : 0 < b := by omega
  have hP : 0 < P := pow_pos hb0 _
  have hPb : P * b = b ^ (b - 1 - j) := by
    rw [hPdef, ← pow_succ]; congr 1; omega
  have hM1 : 1 ≤ (Xn - 1) * P := Nat.mul_pos (by omega) hP
  have hMb : (Xn - 1) * P ≤ b ^ (b - 1) := by
    calc (Xn - 1) * P ≤ b * P := Nat.mul_le_mul_right _ (by omega)
      _ = b ^ (b - 1 - j) := by rw [mul_comm, hPb]
      _ ≤ b ^ (b - 1) := Nat.pow_le_pow_right hb0 (by omega)
  obtain ⟨x, hx1, hxb, hxM, hxe⟩ := exists_steer_digit (by omega) hM1 hMb
  set v := x ^ x
  have hv : 1 ≤ v := Nat.one_le_pow _ _ hx1
  obtain ⟨c, hcv, hdig, hge, hle⟩ := steer (b := b) (z := b - Xn) Y hP hv (by omega) (by omega)
    (by rw [show b - (b - Xn) - 1 = Xn - 1 by omega]; exact hxM)
  refine ⟨x, c, hx1, hxb, ?_, ?_, ?_, ?_⟩
  · -- the number of copies
    have hXn1 : (0 : ℝ) < (Xn : ℝ) - 1 := by
      have : (2 : ℝ) ≤ Xn := by exact_mod_cast hXn
      linarith
    have hvr : (0 : ℝ) < v := by exact_mod_cast hv
    have hPr : (0 : ℝ) < P := by exact_mod_cast hP
    have hcvr : (c : ℝ) * v < ((b : ℝ) - Xn) * P + v := by
      have : ((c * v : ℕ) : ℝ) < (((b - Xn) * P + v : ℕ) : ℝ) := by exact_mod_cast hcv
      push_cast [Nat.cast_sub (show Xn ≤ b by omega)] at this
      exact this
    have hMr : ((Xn : ℝ) - 1) * P ≤ Real.exp 1 * b * v := by
      have : (((Xn - 1) * P : ℕ) : ℝ) ≤ Real.exp 1 * b * v := by exact_mod_cast hxe
      push_cast [Nat.cast_sub (show 1 ≤ Xn by omega)] at this
      exact this
    have hbXn : (0 : ℝ) ≤ (b : ℝ) - Xn := by
      have : (Xn : ℝ) ≤ b := by exact_mod_cast (show Xn ≤ b by omega)
      linarith
    have h1 : (c : ℝ) < ((b : ℝ) - Xn) * P / v + 1 := by
      rw [div_add_one hvr.ne', lt_div_iff₀ hvr]; exact hcvr
    have h2 : ((b : ℝ) - Xn) * P / v ≤ Real.exp 1 * (b - Xn) * b / (Xn - 1) := by
      rw [div_le_div_iff₀ hvr hXn1]
      have := mul_le_mul_of_nonneg_left hMr hbXn
      nlinarith
    linarith
  · simp only [Nat.div_div_eq_div_mul, hPb] at hge hle
    have hq := no_carry hb0 (by omega : X ≤ b - 1) hj' hge hle
    have := (div_succ_eq_of_div_eq (b := b) (Y := Y) (Y' := Y + c * v) hj hjb hq.1).1
    rw [h0] at this
    exact this
  · intro i hi1 hij
    simp only [Nat.div_div_eq_div_mul, hPb] at hge hle
    have hq := no_carry hb0 (by omega : X ≤ b - 1) hj' hge hle
    rcases Nat.lt_or_ge i j with hlt | hge'
    · rw [(div_succ_eq_of_div_eq (b := b) (Y := Y) (Y' := Y + c * v) hj hjb hq.1).2 i hlt]
      exact hlow i hi1 hlt
    · rw [show i = j by omega]
      exact hq.2
  · have : b - (b - Xn) = Xn := by omega
    rw [this] at hdig
    exact hdig


/-- The first `k` base-`b` digits of `N`, most significant first, have value `N mod b^k`. -/
lemma P_map_range_digits (b : ℕ) : ∀ (k N : ℕ),
    P b ((List.range k).map fun i => N / b ^ (k - 1 - i) % b) = N % b ^ k := by
  intro k
  induction k with
  | zero => intro N; simp [Nat.mod_one]
  | succ k ih =>
    intro N
    rw [List.range_succ, List.map_append, List.map_singleton, P_append_singleton,
      show k + 1 - 1 - k = 0 by omega, pow_zero, Nat.div_one]
    have hmap : ((List.range k).map fun i => N / b ^ (k + 1 - 1 - i) % b) =
        (List.range k).map fun i => N / b / b ^ (k - 1 - i) % b := by
      refine List.map_congr_left fun i hi => ?_
      have hi : i < k := List.mem_range.1 hi
      rw [Nat.div_div_eq_div_mul, ← pow_succ', show k - 1 - i + 1 = k + 1 - 1 - i by omega]
    rw [hmap, ih, pow_succ', Nat.mod_mul, Nat.cast_id]

/-- `F` of a list of nonzero digits is the sum of `d^d`, under either convention. -/
lemma Fs_eq_sum_pow {m : ℕ} {L : List ℕ} (hL : ∀ d ∈ L, 1 ≤ d) :
    Fs m L = (L.map fun d => d ^ d).sum := by
  unfold Fs
  congr 1
  exact List.map_congr_left fun d hd => w_of_ne_zero m (by have := hL d hd; omega)

/-- The zone steps of Theorem 35.13 (Step 2 for positions `2, ..., T`): starting from one copy
of `b - 1` whose digit 1 is below `X`, copies of steering digits make digits `1, ..., j - 1`
at most `X` and digit `j` below `X`, with at most `e (b - X) b / (X - 1) + 1` copies per
position. -/
lemma steer_zone {b X T : ℕ} (hb : 3 ≤ b) (hTb : T + 2 ≤ b) (hX2 : 2 ≤ X) (hXb : X ≤ b - 1)
    (h1 : (b - 1) ^ (b - 1) / b ^ (b - 2) < X) :
    ∀ j, 1 ≤ j → j ≤ T → ∃ Lc : List ℕ, (∀ d ∈ Lc, 1 ≤ d ∧ d < b) ∧
      (Lc.length : ℝ) ≤ ((j - 1 : ℕ) : ℝ) * (Real.exp 1 * (b - X) * b / (X - 1) + 1) ∧
      ((b - 1) ^ (b - 1) + (Lc.map fun d => d ^ d).sum) / b ^ (b - 1) = 0 ∧
      (∀ i, 1 ≤ i → i < j →
        ((b - 1) ^ (b - 1) + (Lc.map fun d => d ^ d).sum) / b ^ (b - 1 - i) % b ≤ X) ∧
      ((b - 1) ^ (b - 1) + (Lc.map fun d => d ^ d).sum) / b ^ (b - 1 - j) % b < X := by
  intro j hj
  induction j, hj using Nat.le_induction with
  | base =>
    intro _
    refine ⟨[], by simp, by simp, ?_, fun i hi1 hi => by omega, ?_⟩
    · simp only [List.map_nil, List.sum_nil, add_zero]
      exact Nat.div_eq_of_lt (Nat.pow_lt_pow_left (by omega) (by omega))
    · simp only [List.map_nil, List.sum_nil, add_zero]
      rw [show b - 1 - 1 = b - 2 by omega]
      exact (Nat.mod_le _ _).trans_lt h1
  | succ j hj ih =>
    intro hjT
    obtain ⟨Lc, hLc, hlen, h0, hlow, hj'⟩ := ih (by omega)
    obtain ⟨x, c, hx1, hxb, hc, h0', hlow', hj''⟩ :=
      steer_step (X := X) (Xn := X) hb hj (by omega) hXb hX2 hXb h0 hlow hj'
    refine ⟨Lc ++ List.replicate c x, ?_, ?_, ?_, fun i hi1 hi => ?_, ?_⟩
    · intro d hd
      rcases List.mem_append.1 hd with hd | hd
      · exact hLc d hd
      · rw [List.eq_of_mem_replicate hd]; exact ⟨hx1, hxb⟩
    · rw [List.length_append, List.length_replicate, show j + 1 - 1 = (j - 1) + 1 by omega]
      push_cast
      linarith
    · simpa [List.sum_replicate, add_assoc] using h0'
    · simpa [List.sum_replicate, add_assoc] using hlow' i hi1 (by omega)
    · simpa [List.sum_replicate, add_assoc] using hj''

/-- `T X^X + b < b^(X + 2)` for `1 ≤ T ≤ b`, `X ≥ 1` and `X < b`: the weights of the matched
digits and the zeros stay below the place value of digit `T + 1` (Step 3). -/
lemma E_bound {b T X : ℕ} (hb : 3 ≤ b) (hT : T ≤ b) (hXb : X < b) :
    T * X ^ X + b < b ^ (X + 2) := by
  have h1 : X ^ X ≤ b ^ X := Nat.pow_le_pow_left hXb.le X
  have h2 : 1 ≤ b ^ X := Nat.one_le_pow _ _ (by omega)
  have h3 : T * X ^ X ≤ b * b ^ X := Nat.mul_le_mul hT h1
  have h4 : b ≤ b * b ^ X := Nat.le_mul_of_pos_right _ h2
  have h5 : b ^ (X + 2) = b * b * b ^ X := by ring
  rw [h5]
  have : 3 * (b * b ^ X) ≤ b * (b * b ^ X) := Nat.mul_le_mul_right _ hb
  have h6 : 0 < b * b ^ X := Nat.mul_pos (by omega) (by omega)
  nlinarith

/-- **Theorem 35.13** (section 35.5.1). Let `b ≥ 3` and `T ≥ 1` with
(a) `T + 5 ≤ b (1 - e^(-1 + 1/b))` and
(b) `1 + T (e (T + 4) b / (b - T - 5) + 1) + e b / (b - 2) + 1 + T ≤ b - 2`.
Then for each convention `m ≤ 1` there is a string `n` of `b - 1` digits with
`0 < |n - F(n)| < b^(b - 1 - T)` and `n ≥ (b/e - 1) b^(b-2)`.

The second half of (a), `2 (T + 4) ≤ b`, is not needed: the steering stops at the first copy
after which the part above the steered digit reaches the next multiple of `b`, and one copy
raises that part by at most `b - z - 1` (`steer`), whatever the size of the zone `z`. The zone
is `[b - T - 4, b - 1]` for digits 1 to `T` and `{b - 1}` for digit `T + 1`. -/
theorem theorem35_13 {b T m : ℕ} (hm : m ≤ 1) (hb : 3 ≤ b) (hT : 1 ≤ T)
    (ha : (T : ℝ) + 5 ≤ b * (1 - Real.exp (-1 + 1 / b)))
    (hbb : 1 + T * (Real.exp 1 * (T + 4) * b / (b - T - 5) + 1) + Real.exp 1 * b / (b - 2) + 1 +
      T ≤ (b : ℝ) - 2) :
    ∃ n : List ℕ, n.length = b - 1 ∧ (∀ d ∈ n, d < b) ∧ (∀ h : n ≠ [], n.head h ≠ 0) ∧
      0 < |((P b n : ℕ) : ℤ) - Fs m n| ∧ |((P b n : ℕ) : ℤ) - Fs m n| < (b : ℤ) ^ (b - 1 - T) ∧
      ((b : ℝ) / Real.exp 1 - 1) * (b : ℝ) ^ (b - 2) ≤ P b n := by
  have hbr : (3 : ℝ) ≤ b := by exact_mod_cast hb
  have he3 : Real.exp 1 < 3 := by have := Real.exp_one_lt_d9; linarith
  have he0 : 0 < Real.exp 1 := Real.exp_pos 1
  -- `T + 6 ≤ b`
  have hTb : T + 6 ≤ b := by
    have : (T : ℝ) + 5 < b := by
      have := Real.exp_pos (-1 + 1 / (b : ℝ))
      nlinarith
    have : T + 5 < b := by exact_mod_cast this
    omega
  set X := b - T - 4 with hXdef
  have hXr : (X : ℝ) = b - T - 4 := by
    rw [hXdef, Nat.cast_sub (by omega), Nat.cast_sub (by omega)]; push_cast; ring
  -- `b^(b-1) ≤ e (b-1)^(b-1)`
  have hθ : (b : ℝ) ^ (b - 1) ≤ Real.exp 1 * ((b - 1 : ℕ) : ℝ) ^ (b - 1) := by
    have h := add_one_pow_le_exp_mul (x := b - 1) (by omega)
    rwa [show ((b - 1 : ℕ) : ℝ) + 1 = b by rw [Nat.cast_sub (by omega)]; push_cast; ring] at h
  -- Step 1: digit 1 of `(b-1)^(b-1)` is below `X`, by (a)
  have h1 : (b - 1) ^ (b - 1) / b ^ (b - 2) < X := by
    rw [Nat.div_lt_iff_lt_mul (pow_pos (by omega) _)]
    have hb0 : (0 : ℝ) < b := by linarith
    have hq : (1 : ℝ) - 1 / b ≤ Real.exp (-(1 / b)) := by
      have := Real.add_one_le_exp (-(1 / (b : ℝ))); linarith
    have hq0 : (0 : ℝ) ≤ 1 - 1 / b := by
      rw [sub_nonneg, div_le_one hb0]; linarith
    have hpow : ((b - 1 : ℕ) : ℝ) ^ (b - 1) = (b : ℝ) ^ (b - 1) * (1 - 1 / b) ^ (b - 1) := by
      rw [← mul_pow]; congr 1; rw [Nat.cast_sub (by omega)]; field_simp; push_cast; ring
    have hexp : (1 - 1 / (b : ℝ)) ^ (b - 1) ≤ Real.exp (-1 + 1 / b) := by
      calc (1 - 1 / (b : ℝ)) ^ (b - 1) ≤ Real.exp (-(1 / b)) ^ (b - 1) :=
            pow_le_pow_left₀ hq0 hq _
        _ = Real.exp (-1 + 1 / b) := by
            rw [← Real.exp_nat_mul]; congr 1
            rw [Nat.cast_sub (by omega)]; field_simp; push_cast; ring
    have hbb2 : (b : ℝ) ^ (b - 1) = b * (b : ℝ) ^ (b - 2) := by
      rw [← pow_succ']; congr 1; omega
    have key : ((b - 1 : ℕ) : ℝ) ^ (b - 1) ≤ ((b : ℝ) - T - 5) * (b : ℝ) ^ (b - 2) := by
      rw [hpow, hbb2]
      have hp : (0 : ℝ) ≤ (b : ℝ) ^ (b - 2) := by positivity
      have : b * Real.exp (-1 + 1 / b) ≤ b - T - 5 := by nlinarith
      calc (b : ℝ) * (b : ℝ) ^ (b - 2) * (1 - 1 / b) ^ (b - 1)
          ≤ (b : ℝ) * (b : ℝ) ^ (b - 2) * Real.exp (-1 + 1 / b) :=
            mul_le_mul_of_nonneg_left hexp (by positivity)
        _ = (b * Real.exp (-1 + 1 / b)) * (b : ℝ) ^ (b - 2) := by ring
        _ ≤ ((b : ℝ) - T - 5) * (b : ℝ) ^ (b - 2) := mul_le_mul_of_nonneg_right this hp
    have : ((b - 1) ^ (b - 1) : ℕ) < X * b ^ (b - 2) := by
      have hlt : ((b : ℝ) - T - 5) * (b : ℝ) ^ (b - 2) < X * (b : ℝ) ^ (b - 2) := by
        rw [hXr]; have : (0 : ℝ) < (b : ℝ) ^ (b - 2) := by positivity
        nlinarith
      have : (((b - 1) ^ (b - 1) : ℕ) : ℝ) < ((X * b ^ (b - 2) : ℕ) : ℝ) := by
        push_cast; linarith
      exact_mod_cast this
    exact this
  -- Step 2: the zone steps, then digit `T + 1`
  obtain ⟨Lc0, hLc0, hlen0, h00, hlow0, hT0⟩ :=
    steer_zone (X := X) hb (by omega) (by omega) (by omega) h1 T hT le_rfl
  obtain ⟨x, c, hx1, hxb, hc, h0, hlow, hlast⟩ :=
    steer_step (X := X) (Xn := b - 1) hb hT (by omega) (by omega) (by omega) le_rfl h00 hlow0 hT0
  set Lc := Lc0 ++ List.replicate c x with hLcdef
  have hLc : ∀ d ∈ Lc, 1 ≤ d ∧ d < b := by
    intro d hd
    rcases List.mem_append.1 hd with hd | hd
    · exact hLc0 d hd
    · rw [List.eq_of_mem_replicate hd]; exact ⟨hx1, hxb⟩
  set Y := (b - 1) ^ (b - 1) + (Lc.map fun d => d ^ d).sum with hYdef
  have hYeq : Y = (b - 1) ^ (b - 1) + (Lc0.map fun d => d ^ d).sum + c * x ^ x := by
    simp [hYdef, hLcdef, List.sum_replicate, add_assoc]
  rw [← hYeq] at h0 hlow hlast
  -- the budget: at most `b - 3 - T` copies
  have hlenr : (Lc.length : ℝ) + T + 1 ≤ (b : ℝ) - 2 := by
    have hBz : 0 ≤ Real.exp 1 * (b - X) * b / (X - 1) + 1 := by
      rw [hXr]
      have : (0 : ℝ) < (b : ℝ) - T - 4 - 1 := by
        have : ((T + 6 : ℕ) : ℝ) ≤ b := by exact_mod_cast hTb
        push_cast at this; linarith
      have : (0 : ℝ) ≤ (b : ℝ) - (b - T - 4) := by linarith
      positivity
    have hT1 : ((T - 1 : ℕ) : ℝ) ≤ T := by
      rw [Nat.cast_sub hT]; push_cast; linarith
    have e1 : Real.exp 1 * (b - X) * b / (X - 1) + 1 =
        Real.exp 1 * (T + 4) * b / (b - T - 5) + 1 := by
      rw [hXr]; congr 2 <;> ring
    have e2 : Real.exp 1 * ((b : ℝ) - ((b - 1 : ℕ) : ℝ)) * b / (((b - 1 : ℕ) : ℝ) - 1) + 1 =
        Real.exp 1 * b / (b - 2) + 1 := by
      rw [Nat.cast_sub (by omega)]; push_cast; congr 2 <;> ring
    rw [e2] at hc
    rw [e1] at hBz hlen0
    have : (Lc.length : ℝ) = Lc0.length + c := by
      rw [hLcdef, List.length_append, List.length_replicate]; push_cast; ring
    have h3 : ((T - 1 : ℕ) : ℝ) * (Real.exp 1 * (T + 4) * b / (b - T - 5) + 1) ≤
        T * (Real.exp 1 * (T + 4) * b / (b - T - 5) + 1) :=
      mul_le_mul_of_nonneg_right hT1 hBz
    linarith
  have hlen : Lc.length + T + 1 ≤ b - 2 := by
    have : ((Lc.length + T + 1 : ℕ) : ℝ) ≤ ((b - 2 : ℕ) : ℝ) := by
      rw [Nat.cast_sub (by omega)]; push_cast; linarith
    exact_mod_cast this
  -- Step 3: the string
  set N := Y / b ^ (b - 1 - T) with hNdef
  have hb0 : 0 < b := by omega
  have hNlt : N < b ^ T := by
    rw [hNdef, Nat.div_lt_iff_lt_mul (pow_pos hb0 _), ← pow_add,
      show T + (b - 1 - T) = b - 1 by omega]
    have := Nat.div_add_mod Y (b ^ (b - 1))
    rw [h0] at this
    have := Nat.mod_lt Y (pow_pos hb0 (b - 1))
    omega
  set A := (List.range T).map fun i => N / b ^ (T - 1 - i) % b with hAdef
  have hPA : P b A = N := by rw [hAdef, P_map_range_digits, Nat.mod_eq_of_lt hNlt]
  have hAlen : A.length = T := by simp [hAdef]
  have hAdig : ∀ a ∈ A, a ≤ X := by
    intro a ha
    rw [hAdef, List.mem_map] at ha
    obtain ⟨i, hi, rfl⟩ := ha
    have hi : i < T := List.mem_range.1 hi
    have e : N / b ^ (T - 1 - i) = Y / b ^ (b - 1 - (i + 1)) := by
      rw [hNdef, Nat.div_div_eq_div_mul, ← pow_add]; congr 2; omega
    rw [e]
    exact hlow (i + 1) (by omega) (by omega)
  -- the leading digit
  set Y0 := (b - 1) ^ (b - 1)
  have hY0Y : Y0 ≤ Y := by rw [hYdef]; omega
  have hlead : ((b : ℝ) / Real.exp 1 - 1) < ((Y0 / b ^ (b - 2) : ℕ) : ℝ) := by
    have hpos : (0 : ℝ) < (b : ℝ) ^ (b - 2) := by positivity
    have hfl : (Y0 : ℝ) / (b : ℝ) ^ (b - 2) < ((Y0 / b ^ (b - 2) : ℕ) : ℝ) + 1 := by
      rw [div_lt_iff₀ hpos]
      have := Nat.lt_div_mul_add (a := Y0) (pow_pos hb0 (b - 2))
      have : ((Y0 : ℕ) : ℝ) < (((Y0 / b ^ (b - 2)) * b ^ (b - 2) + b ^ (b - 2) : ℕ) : ℝ) := by
        exact_mod_cast this
      push_cast at this; linarith
    have hbe : (b : ℝ) / Real.exp 1 ≤ (Y0 : ℝ) / (b : ℝ) ^ (b - 2) := by
      rw [div_le_div_iff₀ he0 hpos]
      have hbb2 : (b : ℝ) ^ (b - 1) = b * (b : ℝ) ^ (b - 2) := by
        rw [← pow_succ']; congr 1; omega
      have : (Y0 : ℝ) = ((b - 1 : ℕ) : ℝ) ^ (b - 1) := by simp [Y0]
      rw [this]; nlinarith
    linarith
  have hdiv_ge : Y0 / b ^ (b - 2) ≤ Y / b ^ (b - 2) := Nat.div_le_div_right hY0Y
  have hlead_pos : 1 ≤ Y / b ^ (b - 2) := by
    have : (0 : ℝ) < ((Y0 / b ^ (b - 2) : ℕ) : ℝ) := by
      have : (1 : ℝ) < (b : ℝ) / Real.exp 1 := by rw [lt_div_iff₀ he0]; linarith
      linarith
    have : 0 < Y0 / b ^ (b - 2) := by exact_mod_cast this
    omega
  have hN1 : Y / b ^ (b - 2) = N / b ^ (T - 1) := by
    rw [hNdef, Nat.div_div_eq_div_mul, ← pow_add]; congr 2; omega
  have hNb : N / b ^ (T - 1) < b := by
    rw [Nat.div_lt_iff_lt_mul (pow_pos hb0 _), ← pow_succ', show T - 1 + 1 = T by omega]
    exact hNlt
  have hAhead : ∀ h : A ≠ [], A.head h ≠ 0 := by
    intro h
    have : A.head h = N / b ^ (T - 1) % b := by
      simp only [hAdef]
      rw [List.head_map]
      simp
    rw [this, Nat.mod_eq_of_lt hNb, ← hN1]
    omega
  -- the rest of the string
  set z0 := b - 2 - T - Lc.length with hz0
  have hz01 : 1 ≤ z0 := by omega
  set Rest := (b - 1) :: (Lc ++ List.replicate z0 0) with hRestdef
  set Rest' := 0 :: (Lc ++ (b - 1) :: List.replicate (z0 - 1) 0) with hRest'def
  have hRestlen : Rest.length = (b - 2 - T) + 1 := by
    simp only [hRestdef, List.length_cons, List.length_append, List.length_replicate]; omega
  have hdR : ∀ d ∈ Rest, d < b := by
    intro d hd
    simp only [hRestdef, List.mem_cons, List.mem_append] at hd
    rcases hd with rfl | hd | hd
    · omega
    · exact (hLc d hd).2
    · rw [List.eq_of_mem_replicate hd]; omega
  have hperm : Rest.Perm Rest' := by
    have hz : List.replicate z0 0 = 0 :: List.replicate (z0 - 1) 0 := by
      rw [← List.replicate_succ, show z0 - 1 + 1 = z0 by omega]
    rw [hRestdef, hRest'def, hz]
    refine (List.Perm.cons _ List.perm_middle).trans ?_
    refine (List.Perm.swap _ _ _).trans ?_
    exact List.Perm.cons _ List.perm_middle.symm
  have hne : Rest ≠ Rest' := by
    rw [hRestdef, hRest'def]; intro h
    have := List.head_eq_of_cons_eq h
    omega
  have hFs : Fs m (A ++ Rest) = Y + (Fs m A + z0 * m) := by
    rw [hRestdef, Fs_append, Fs_cons, Fs_append, Fs_replicate, w_zero,
      w_of_ne_zero m (show b - 1 ≠ 0 by omega), Fs_eq_sum_pow (fun d hd => (hLc d hd).1), hYdef]
    ring
  have hE : Fs m A + z0 * m < b ^ (b - 2 - T) := by
    have hA : Fs m A ≤ T * X ^ X := by
      unfold Fs
      have := List.sum_le_length_nsmul (A.map (w m)) (X ^ X) (by
        intro y hy
        obtain ⟨a, ha, rfl⟩ := List.mem_map.1 hy
        calc w m a ≤ w m X := w_le_of_le hm (hAdig a ha)
          _ = X ^ X := w_of_ne_zero m (by omega))
      simpa [hAlen] using this
    have hz : z0 * m ≤ b := by
      calc z0 * m ≤ z0 * 1 := Nat.mul_le_mul_left _ hm
        _ ≤ b := by omega
    have := E_bound (T := T) (X := X) hb (by omega) (by omega)
    rw [show X + 2 = b - 2 - T by omega] at this
    omega
  have hYA : Y / b ^ (b - 2 - T + 1) = P b A := by
    rw [hPA, hNdef, show b - 2 - T + 1 = b - 1 - T by omega]
  have hdig : Y / b ^ (b - 2 - T) % b ≤ b - 2 := by
    rw [show b - 2 - T = b - 1 - (T + 1) by omega]; omega
  have hlow_n : ∀ R : List ℕ, R.length = b - 2 - T + 1 →
      ((b : ℝ) / Real.exp 1 - 1) * (b : ℝ) ^ (b - 2) ≤ P b (A ++ R) := by
    intro R hR
    rw [P_append, hR, hPA]
    have h2 : (Y / b ^ (b - 2)) * b ^ (b - 2) ≤ b ^ (b - 2 - T + 1) * N := by
      have hpow : b ^ (b - 2) = b ^ (T - 1) * b ^ (b - 2 - T + 1) := by
        rw [← pow_add]; congr 1; omega
      rw [hN1, hpow, ← mul_assoc, mul_comm (b ^ (b - 2 - T + 1))]
      exact Nat.mul_le_mul_right _ (Nat.div_mul_le_self _ _)
    have h3 : ((Y0 / b ^ (b - 2) : ℕ) : ℝ) * (b : ℝ) ^ (b - 2) ≤
        ((b ^ (b - 2 - T + 1) * N + P b R : ℕ) : ℝ) := by
      have : (Y0 / b ^ (b - 2)) * b ^ (b - 2) ≤ b ^ (b - 2 - T + 1) * N + P b R :=
        (Nat.mul_le_mul_right _ hdiv_ge).trans (h2.trans (Nat.le_add_right _ _))
      exact_mod_cast this
    have hp : (0 : ℝ) ≤ (b : ℝ) ^ (b - 2) := by positivity
    calc ((b : ℝ) / Real.exp 1 - 1) * (b : ℝ) ^ (b - 2)
        ≤ ((Y0 / b ^ (b - 2) : ℕ) : ℝ) * (b : ℝ) ^ (b - 2) :=
          mul_le_mul_of_nonneg_right hlead.le hp
      _ ≤ _ := by exact_mod_cast h3
  have hdA : ∀ a ∈ A, a < b := fun a ha => by have := hAdig a ha; omega
  by_cases hsol : P b (A ++ Rest) = Fs m (A ++ Rest)
  · -- exchange `b - 1` and a zero below the top `T` digits
    obtain ⟨hpos, hlt⟩ := theorem35_13_strict (by omega) hRestlen hdR hperm hne hsol
    have hdR' : ∀ d ∈ Rest', d < b := fun d hd => hdR d (hperm.symm.subset hd)
    refine ⟨A ++ Rest', ?_, ?_, ?_, hpos, ?_, hlow_n Rest' (hperm.length_eq ▸ hRestlen)⟩
    · rw [List.length_append, ← hperm.length_eq, hRestlen, hAlen]; omega
    · intro d hd
      rcases List.mem_append.1 hd with hd | hd
      · exact hdA d hd
      · exact hdR' d hd
    · intro h
      have hA0 : A ≠ [] := by rw [← List.length_pos_iff, hAlen]; omega
      rw [List.head_append_of_ne_nil hA0]
      exact hAhead hA0
    · rw [show b - 1 - T = b - 2 - T + 1 by omega]; exact_mod_cast hlt
  · refine ⟨A ++ Rest, ?_, ?_, ?_, ?_, ?_, hlow_n Rest hRestlen⟩
    · rw [List.length_append, hRestlen, hAlen]; omega
    · intro d hd
      rcases List.mem_append.1 hd with hd | hd
      · exact hdA d hd
      · exact hdR d hd
    · intro h
      have hA0 : A ≠ [] := by rw [← List.length_pos_iff, hAlen]; omega
      rw [List.head_append_of_ne_nil hA0]
      exact hAhead hA0
    · apply abs_pos.2
      intro h
      apply hsol
      have : ((P b (A ++ Rest) : ℕ) : ℤ) = (Fs m (A ++ Rest) : ℤ) := by linarith
      exact_mod_cast this
    · have := theorem35_13_step3 (A := A) (by omega) hRestlen hdR hYA hdig hE hFs
      rw [show b - 1 - T = b - 2 - T + 1 by omega]; exact_mod_cast this
/-! ### Corollary 35.14: the thresholds 27, 49 and 77 -/

/-- Condition (a) of Theorem 35.13 holds when `3 (T + 5) ≤ b`, since `e^(-1 + 1/b) ≤ e^(-1/2)
≤ 2/3`. -/
lemma theorem35_13_cond_a {b T : ℕ} (h : 3 * (T + 5) ≤ b) :
    (T : ℝ) + 5 ≤ b * (1 - Real.exp (-1 + 1 / b)) := by
  have hb : (15 : ℝ) ≤ b := by
    have : (15 : ℕ) ≤ b := by omega
    exact_mod_cast this
  have h1 : -1 + 1 / (b : ℝ) ≤ -(1 / 2) := by
    have : 1 / (b : ℝ) ≤ 1 / 2 := by
      rw [div_le_div_iff₀ (by linarith) (by norm_num)]; linarith
    linarith
  have h2 : Real.exp (-1 + 1 / b) ≤ 2 / 3 := by
    calc Real.exp (-1 + 1 / b) ≤ Real.exp (-(1 / 2)) := Real.exp_le_exp.2 h1
      _ = 1 / Real.exp (1 / 2) := by rw [Real.exp_neg, inv_eq_one_div]
      _ ≤ 2 / 3 := by
          rw [div_le_div_iff₀ (Real.exp_pos _) (by norm_num)]
          have := Real.add_one_le_exp (1 / 2 : ℝ)
          linarith
  have h' : ((3 * (T + 5) : ℕ) : ℝ) ≤ b := by exact_mod_cast h
  push_cast at h'
  nlinarith

/-- Condition (b) of Theorem 35.13 only gets easier as `b` grows: if it holds at `b0` with
`e` replaced by `2.7182818286 > e`, it holds at every `b ≥ b0`. -/
lemma theorem35_13_cond_b {b b0 T : ℕ} (h0 : T + 6 ≤ b0) (hb : b0 ≤ b)
    (h : 1 + T * (2.7182818286 * (T + 4) * b0 / (b0 - T - 5) + 1) +
      2.7182818286 * b0 / (b0 - 2) + 1 + T ≤ (b0 : ℝ) - 2) :
    1 + T * (Real.exp 1 * (T + 4) * b / (b - T - 5) + 1) + Real.exp 1 * b / (b - 2) + 1 + T ≤
      (b : ℝ) - 2 := by
  have he := Real.exp_one_lt_d9
  have he0 := Real.exp_pos 1
  have h0r : (T : ℝ) + 6 ≤ b0 := by exact_mod_cast h0
  have hbr : (b0 : ℝ) ≤ b := by exact_mod_cast hb
  have hT0 : (0 : ℝ) ≤ T := T.cast_nonneg
  have hd0 : (0 : ℝ) < b0 - T - 5 := by linarith
  have hd : (0 : ℝ) < b - T - 5 := by linarith
  -- `b / (b - c)` falls with `b`
  have r1 : (b : ℝ) / (b - T - 5) ≤ b0 / (b0 - T - 5) := by
    rw [div_le_div_iff₀ hd hd0]; nlinarith
  have r2 : (b : ℝ) / (b - 2) ≤ b0 / (b0 - 2) := by
    rw [div_le_div_iff₀ (by linarith) (by linarith)]; nlinarith
  have k1 : Real.exp 1 * (T + 4) * b / (b - T - 5) ≤
      2.7182818286 * (T + 4) * b0 / (b0 - T - 5) := by
    rw [mul_div_assoc, mul_div_assoc]
    have : (0 : ℝ) ≤ b / (b - T - 5) := div_nonneg (by linarith) hd.le
    have : Real.exp 1 * (T + 4) ≤ 2.7182818286 * (T + 4) := by nlinarith
    calc Real.exp 1 * (T + 4) * (b / (b - T - 5)) ≤ 2.7182818286 * (T + 4) * (b / (b - T - 5)) :=
          mul_le_mul_of_nonneg_right this (by positivity)
      _ ≤ 2.7182818286 * (T + 4) * (b0 / (b0 - T - 5)) :=
          mul_le_mul_of_nonneg_left r1 (by positivity)
  have k2 : Real.exp 1 * b / (b - 2) ≤ 2.7182818286 * b0 / (b0 - 2) := by
    rw [mul_div_assoc, mul_div_assoc]
    have : (0 : ℝ) ≤ b / (b - 2) := div_nonneg (by linarith) (by linarith)
    calc Real.exp 1 * (b / (b - 2)) ≤ 2.7182818286 * (b / (b - 2)) :=
          mul_le_mul_of_nonneg_right (by linarith) this
      _ ≤ 2.7182818286 * (b0 / (b0 - 2)) := mul_le_mul_of_nonneg_left r2 (by norm_num)
  have k3 : (T : ℝ) * (Real.exp 1 * (T + 4) * b / (b - T - 5) + 1) ≤
      T * (2.7182818286 * (T + 4) * b0 / (b0 - T - 5) + 1) :=
    mul_le_mul_of_nonneg_left (by linarith) hT0
  linarith

/-- From Theorem 35.13 with parameter `T`: `|n - F(n)| b^(T-1) < n`, for `b ≥ 6`. -/
lemma theorem35_13_rel {b T m : ℕ} (hm : m ≤ 1) (hb : 6 ≤ b) (hT : 1 ≤ T)
    (ha : (T : ℝ) + 5 ≤ b * (1 - Real.exp (-1 + 1 / b)))
    (hbb : 1 + T * (Real.exp 1 * (T + 4) * b / (b - T - 5) + 1) + Real.exp 1 * b / (b - 2) + 1 +
      T ≤ (b : ℝ) - 2) :
    ∃ n : List ℕ, n.length = b - 1 ∧ (∀ d ∈ n, d < b) ∧ (∀ h : n ≠ [], n.head h ≠ 0) ∧
      0 < |((P b n : ℕ) : ℤ) - Fs m n| ∧
      |((P b n : ℕ) : ℤ) - Fs m n| * (b : ℤ) ^ (T - 1) < P b n := by
  obtain ⟨n, hlen, hd, hh, hpos, hlt, hge⟩ := theorem35_13 hm (by omega) hT ha hbb
  refine ⟨n, hlen, hd, hh, hpos, ?_⟩
  have hTb : T + 2 ≤ b := by
    have : (T : ℝ) + 5 < b := by
      have := Real.exp_pos (-1 + 1 / (b : ℝ))
      have h6 : (6 : ℝ) ≤ b := by exact_mod_cast hb
      have : (0 : ℝ) < b := by linarith
      nlinarith
    have : T + 5 < b := by exact_mod_cast this
    omega
  have he := Real.exp_one_lt_d9
  have hbr : (6 : ℝ) ≤ b := by exact_mod_cast hb
  have hge' : (b : ℝ) ^ (b - 2) ≤ P b n := by
    have : (1 : ℝ) ≤ b / Real.exp 1 - 1 := by
      rw [le_sub_iff_add_le, le_div_iff₀ (Real.exp_pos 1)]; linarith
    have hp : (0 : ℝ) ≤ (b : ℝ) ^ (b - 2) := by positivity
    nlinarith
  have hge'' : b ^ (b - 2) ≤ P b n := by exact_mod_cast hge'
  have hp : (0 : ℤ) < (b : ℤ) ^ (T - 1) := by positivity
  calc |((P b n : ℕ) : ℤ) - Fs m n| * (b : ℤ) ^ (T - 1)
      < (b : ℤ) ^ (b - 1 - T) * (b : ℤ) ^ (T - 1) :=
        mul_lt_mul_of_pos_right hlt hp
    _ = (b : ℤ) ^ (b - 2) := by rw [← pow_add]; congr 1; omega
    _ ≤ P b n := by exact_mod_cast hge''

/-- **Corollary 35.14** (section 35.5.1), the thresholds, under either convention. Every base
`b ≥ 27` has a string `n` of `b - 1` digits with `0 < |n - F(n)| < b^(b-2)` (`T = 1`); every
base `b ≥ 49` one with `0 < |n - F(n)| < n / b` (`t ≥ 1`, from `T = 2`); and every base
`b ≥ 77` one with `0 < |n - F(n)| < n / b^2` (`t ≥ 2`, from `T = 3`). The library computes the
thresholds and extends them by monotonicity; here condition (b) is checked at the threshold
with `e < 2.7182818286` and carried to larger `b` by `theorem35_13_cond_b`. -/
theorem corollary35_14 {m : ℕ} (hm : m ≤ 1) :
    (∀ b, 27 ≤ b → ∃ n : List ℕ, n.length = b - 1 ∧ (∀ d ∈ n, d < b) ∧
      (∀ h : n ≠ [], n.head h ≠ 0) ∧ 0 < |((P b n : ℕ) : ℤ) - Fs m n| ∧
      |((P b n : ℕ) : ℤ) - Fs m n| < (b : ℤ) ^ (b - 2)) ∧
    (∀ b, 49 ≤ b → ∃ n : List ℕ, n.length = b - 1 ∧ (∀ d ∈ n, d < b) ∧
      (∀ h : n ≠ [], n.head h ≠ 0) ∧ 0 < |((P b n : ℕ) : ℤ) - Fs m n| ∧
      |((P b n : ℕ) : ℤ) - Fs m n| * b < P b n) ∧
    (∀ b, 77 ≤ b → ∃ n : List ℕ, n.length = b - 1 ∧ (∀ d ∈ n, d < b) ∧
      (∀ h : n ≠ [], n.head h ≠ 0) ∧ 0 < |((P b n : ℕ) : ℤ) - Fs m n| ∧
      |((P b n : ℕ) : ℤ) - Fs m n| * b ^ 2 < P b n) := by
  refine ⟨fun b hb => ?_, fun b hb => ?_, fun b hb => ?_⟩
  · obtain ⟨n, h1, h2, h3, h4, h5, -⟩ := theorem35_13 (T := 1) hm (by omega) le_rfl
      (theorem35_13_cond_a (by omega))
      (theorem35_13_cond_b (b0 := 27) (by norm_num) hb (by norm_num))
    exact ⟨n, h1, h2, h3, h4, by simpa [show b - 1 - 1 = b - 2 by omega] using h5⟩
  · obtain ⟨n, h1, h2, h3, h4, h5⟩ := theorem35_13_rel (T := 2) hm (by omega) (by norm_num)
      (theorem35_13_cond_a (by omega))
      (theorem35_13_cond_b (b0 := 49) (by norm_num) hb (by norm_num))
    exact ⟨n, h1, h2, h3, h4, by simpa using h5⟩
  · obtain ⟨n, h1, h2, h3, h4, h5⟩ := theorem35_13_rel (T := 3) hm (by omega) (by norm_num)
      (theorem35_13_cond_a (by omega))
      (theorem35_13_cond_b (b0 := 77) (by norm_num) hb (by norm_num))
    exact ⟨n, h1, h2, h3, h4, by simpa using h5⟩

/-- **Corollary 35.14**, the size of `T(b)` from below: if `e (T + 6)^2 ≤ b` and `T ≥ 1`, the
conditions (a) and (b) of Theorem 35.13 hold. So `T(b) ≥ sqrt(b/e) - 6`. -/
theorem corollary35_14_lower {b T : ℕ} (hT : 1 ≤ T) (hb : Real.exp 1 * ((T : ℝ) + 6) ^ 2 ≤ b) :
    ((T : ℝ) + 5 ≤ b * (1 - Real.exp (-1 + 1 / b))) ∧
      1 + T * (Real.exp 1 * (T + 4) * b / (b - T - 5) + 1) + Real.exp 1 * b / (b - 2) + 1 + T ≤
        (b : ℝ) - 2 := by
  have he := Real.exp_one_lt_d9
  have he' := Real.exp_one_gt_d9
  set e := Real.exp 1
  have hx : (1 : ℝ) ≤ T := by exact_mod_cast hT
  set x : ℝ := (T : ℝ)
  set B : ℝ := (b : ℝ)
  have hB : 2.7 * (x + 6) ^ 2 ≤ B := by nlinarith
  constructor
  · apply theorem35_13_cond_a
    have : ((3 * (T + 5) : ℕ) : ℝ) ≤ b := by push_cast; nlinarith
    exact_mod_cast this
  · have hd1 : 0 < B - x - 5 := by nlinarith
    have hd2 : 0 < B - 2 := by nlinarith
    have P1 : e * (x + 4) * B / (B - x - 5) ≤ e * (x + 4) + 2 := by
      rw [div_le_iff₀ hd1]
      nlinarith
    have P2 : e * B / (B - 2) ≤ e + 1 := by
      rw [div_le_iff₀ hd2]
      nlinarith
    have hx0 : 0 ≤ x := by linarith
    have : x * (e * (x + 4) * B / (B - x - 5) + 1) ≤ x * (e * (x + 4) + 3) := by
      apply mul_le_mul_of_nonneg_left _ hx0; linarith
    nlinarith

/-- **Corollary 35.14**, the size of `T(b)` from above: condition (b) of Theorem 35.13 forces
`e T^2 < b`. So `T(b) < sqrt(b/e)`, and with `corollary35_14_lower`,
`T(b) = sqrt(b/e) - O(1)`. -/
theorem corollary35_14_upper {b T : ℕ} (hTb : T + 6 ≤ b)
    (hbb : 1 + T * (Real.exp 1 * (T + 4) * b / (b - T - 5) + 1) + Real.exp 1 * b / (b - 2) + 1 +
      T ≤ (b : ℝ) - 2) :
    Real.exp 1 * (T : ℝ) ^ 2 < b := by
  have he0 := Real.exp_pos 1
  have hTr : (T : ℝ) + 6 ≤ b := by exact_mod_cast hTb
  have hT0 : (0 : ℝ) ≤ T := T.cast_nonneg
  have hd1 : (0 : ℝ) < b - T - 5 := by linarith
  have hd2 : (0 : ℝ) < b - 2 := by linarith
  have P1 : Real.exp 1 * (T + 4) ≤ Real.exp 1 * (T + 4) * b / (b - T - 5) := by
    rw [le_div_iff₀ hd1]
    have : (0 : ℝ) ≤ Real.exp 1 * (T + 4) := by positivity
    nlinarith
  have P2 : 0 ≤ Real.exp 1 * b / (b - 2) := by positivity
  have : (T : ℝ) * (Real.exp 1 * (T + 4)) ≤ T * (Real.exp 1 * (T + 4) * b / (b - T - 5) + 1) := by
    apply mul_le_mul_of_nonneg_left _ hT0; linarith
  nlinarith

/-! ### Corollary 35.14: `T(b)` does not decrease -/

lemma hasDerivAt_condA_fun {t : ℝ} (ht : 0 < t) :
    HasDerivAt (fun s : ℝ => s * (1 - Real.exp (-1 + s⁻¹)))
      (1 - Real.exp (-1 + t⁻¹) * (1 - t⁻¹)) t := by
  have h1 : HasDerivAt (fun s : ℝ => -1 + s⁻¹) (-(t ^ 2)⁻¹) t := by
    simpa using (hasDerivAt_inv ht.ne').const_add (-1 : ℝ)
  have h2 := (h1.exp).const_sub 1
  have h3 := (hasDerivAt_id' t).mul h2
  convert h3 using 1
  field_simp
  ring

/-- The right side `b (1 - e^(-1 + 1/b))` of condition (a) of Theorem 35.13 grows with `b`: its
derivative `1 - e^(-1 + 1/b) (1 - 1/b)` is positive for `b ≥ 1`. -/
lemma condA_monotoneOn :
    MonotoneOn (fun s : ℝ => s * (1 - Real.exp (-1 + s⁻¹))) (Set.Ici 1) := by
  refine monotoneOn_of_hasDerivWithinAt_nonneg (convex_Ici 1)
    (fun x hx => (hasDerivAt_condA_fun (by simp at hx; linarith)).continuousAt.continuousWithinAt)
    (fun x hx => (hasDerivAt_condA_fun ?_).hasDerivWithinAt) ?_
  · rw [interior_Ici] at hx; simp at hx; linarith
  · intro x hx
    rw [interior_Ici] at hx
    simp only [Set.mem_Ioi] at hx
    have hx0 : 0 < x := by linarith
    have hinv : x⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hx.le
    have hinv0 : 0 < x⁻¹ := inv_pos.2 hx0
    have he : Real.exp (-1 + x⁻¹) ≤ 1 := Real.exp_le_one_iff.2 (by linarith)
    have : Real.exp (-1 + x⁻¹) * (1 - x⁻¹) ≤ 1 :=
      calc Real.exp (-1 + x⁻¹) * (1 - x⁻¹) ≤ 1 * 1 :=
            mul_le_mul he (by linarith) (by linarith) zero_le_one
        _ = 1 := one_mul 1
    linarith

/-- Condition (a) of Theorem 35.13 only gets easier as `b` grows. -/
lemma condA_mono {b b' T : ℕ} (hb : 1 ≤ b) (hbb : b ≤ b')
    (h : (T : ℝ) + 5 ≤ b * (1 - Real.exp (-1 + 1 / b))) :
    (T : ℝ) + 5 ≤ b' * (1 - Real.exp (-1 + 1 / b')) := by
  have h1 : (1 : ℝ) ≤ b := by exact_mod_cast hb
  have h2 : (b : ℝ) ≤ b' := by exact_mod_cast hbb
  have := condA_monotoneOn (a := (b : ℝ)) (b := (b' : ℝ)) h1 (h1.trans h2) h2
  simp only [one_div] at h ⊢
  exact h.trans this

/-- Condition (b) of Theorem 35.13 only gets easier as `b` grows, for `T + 6 ≤ b`. -/
lemma condB_mono {b b' T : ℕ} (h0 : T + 6 ≤ b) (hb : b ≤ b')
    (h : 1 + T * (Real.exp 1 * (T + 4) * b / (b - T - 5) + 1) + Real.exp 1 * b / (b - 2) + 1 +
      T ≤ (b : ℝ) - 2) :
    1 + T * (Real.exp 1 * (T + 4) * b' / (b' - T - 5) + 1) + Real.exp 1 * b' / (b' - 2) + 1 +
      T ≤ (b' : ℝ) - 2 := by
  have he0 := Real.exp_pos 1
  have h0r : (T : ℝ) + 6 ≤ b := by exact_mod_cast h0
  have hbr : (b : ℝ) ≤ b' := by exact_mod_cast hb
  have hT0 : (0 : ℝ) ≤ T := T.cast_nonneg
  have hd0 : (0 : ℝ) < b - T - 5 := by linarith
  have hd : (0 : ℝ) < b' - T - 5 := by linarith
  have r1 : (b' : ℝ) / (b' - T - 5) ≤ b / (b - T - 5) := by
    rw [div_le_div_iff₀ hd hd0]; nlinarith
  have r2 : (b' : ℝ) / (b' - 2) ≤ b / (b - 2) := by
    rw [div_le_div_iff₀ (by linarith) (by linarith)]; nlinarith
  have k1 : Real.exp 1 * (T + 4) * b' / (b' - T - 5) ≤ Real.exp 1 * (T + 4) * b / (b - T - 5) := by
    rw [mul_div_assoc, mul_div_assoc]
    exact mul_le_mul_of_nonneg_left r1 (by positivity)
  have k2 : Real.exp 1 * b' / (b' - 2) ≤ Real.exp 1 * b / (b - 2) := by
    rw [mul_div_assoc, mul_div_assoc]
    exact mul_le_mul_of_nonneg_left r2 he0.le
  have k3 : (T : ℝ) * (Real.exp 1 * (T + 4) * b' / (b' - T - 5) + 1) ≤
      T * (Real.exp 1 * (T + 4) * b / (b - T - 5) + 1) :=
    mul_le_mul_of_nonneg_left (by linarith) hT0
  linarith

/-- The conditions (a) and (b) of Theorem 35.13 for the base `b` and the number `T` of matched
digits. -/
def NearCond (b T : ℕ) : Prop :=
  (T : ℝ) + 5 ≤ b * (1 - Real.exp (-1 + 1 / b)) ∧
    1 + T * (Real.exp 1 * (T + 4) * b / (b - T - 5) + 1) + Real.exp 1 * b / (b - 2) + 1 + T ≤
      (b : ℝ) - 2

/-- Condition (a) gives `T + 6 ≤ b`, since `e^(-1 + 1/b) > 0`. -/
lemma NearCond.add_six_le {b T : ℕ} (h : NearCond b T) : T + 6 ≤ b := by
  have := Real.exp_pos (-1 + 1 / (b : ℝ))
  have hb0 : (0 : ℝ) ≤ b := b.cast_nonneg
  have : (T : ℝ) + 5 < b := by
    rcases hb0.lt_or_eq with hb | hb
    · nlinarith [h.1]
    · have := h.1; rw [← hb] at this; simp at this; linarith
  have : T + 5 < b := by exact_mod_cast this
  omega

/-- **Corollary 35.14** (section 35.5.1): for fixed `T`, the conditions (a) and (b) of Theorem
35.13 hold for every base above one where they hold. -/
theorem NearCond.mono {b b' T : ℕ} (h : NearCond b T) (hb : b ≤ b') : NearCond b' T := by
  have h6 := h.add_six_le
  exact ⟨condA_mono (by omega) hb h.1, condB_mono h6 hb h.2⟩

open Classical in
/-- `T(b)` of Corollary 35.14: the largest `T` allowed by the conditions (a) and (b) of Theorem
35.13, and `0` if there is none. Condition (a) forces `T < b`, so the search stops at `b`. -/
noncomputable def nearT (b : ℕ) : ℕ := Nat.findGreatest (NearCond b) b

lemma nearCond_nearT {b : ℕ} (h : nearT b ≠ 0) : NearCond b (nearT b) := by
  classical
  exact Nat.findGreatest_spec (P := NearCond b) (m := nearT b) (Nat.findGreatest_le b)
    (Nat.findGreatest_of_ne_zero rfl h)

lemma le_nearT {b T : ℕ} (h : NearCond b T) : T ≤ nearT b := by
  classical
  have h6 := h.add_six_le
  exact Nat.le_findGreatest (by omega) h

/-- **Corollary 35.14** (section 35.5.1): `T(b)` does not decrease with `b`, since for fixed `T`
the left sides of (a) and (b) fall and the right sides grow with `b`. -/
theorem nearT_mono : Monotone nearT := by
  intro b b' hb
  by_cases h : nearT b = 0
  · rw [h]; exact Nat.zero_le _
  · exact le_nearT ((nearCond_nearT h).mono hb)

/-- **Corollary 35.14**: `T(b) ≥ 1` for `b ≥ 27`, `T(b) ≥ 2` for `b ≥ 49` and `T(b) ≥ 3` for
`b ≥ 77`, the thresholds of `corollary35_14`. -/
theorem nearT_thresholds {b : ℕ} :
    (27 ≤ b → 1 ≤ nearT b) ∧ (49 ≤ b → 2 ≤ nearT b) ∧ (77 ≤ b → 3 ≤ nearT b) := by
  refine ⟨fun hb => le_nearT ⟨theorem35_13_cond_a (by omega),
      theorem35_13_cond_b (b0 := 27) (by norm_num) hb (by norm_num)⟩,
    fun hb => le_nearT ⟨theorem35_13_cond_a (by omega),
      theorem35_13_cond_b (b0 := 49) (by norm_num) hb (by norm_num)⟩,
    fun hb => le_nearT ⟨theorem35_13_cond_a (by omega),
      theorem35_13_cond_b (b0 := 77) (by norm_num) hb (by norm_num)⟩⟩

/-- **Corollary 35.14**: the exponent `t = T(b) - log_b(e b/(b - e))` of the near-solutions does
not decrease with `b ≥ 3`, since `T(b)` does not and `log_b(e b/(b - e))` falls: its numerator
falls and stays positive, and its denominator `log b` grows. -/
theorem nearExp_mono {b b' : ℕ} (hb : 3 ≤ b) (hbb : b ≤ b') :
    (nearT b : ℝ) - Real.logb b (Real.exp 1 * b / (b - Real.exp 1)) ≤
      (nearT b' : ℝ) - Real.logb b' (Real.exp 1 * b' / (b' - Real.exp 1)) := by
  have hT : (nearT b : ℝ) ≤ nearT b' := by exact_mod_cast nearT_mono hbb
  have he := Real.exp_one_lt_d9
  have he0 := Real.exp_pos 1
  have he1 := Real.exp_one_gt_d9
  have h3 : (3 : ℝ) ≤ b := by exact_mod_cast hb
  have hbr : (b : ℝ) ≤ b' := by exact_mod_cast hbb
  set e := Real.exp 1
  have hd : 0 < (b : ℝ) - e := by linarith
  have hd' : 0 < (b' : ℝ) - e := by linarith
  -- the arguments are at least 1 and fall
  have hq1 : 1 ≤ e * b' / (b' - e) := by
    rw [le_div_iff₀ hd']; nlinarith
  have hq : e * b' / (b' - e) ≤ e * b / (b - e) := by
    rw [div_le_div_iff₀ hd' hd]; nlinarith [mul_le_mul_of_nonneg_left hbr (sq_nonneg e)]
  have hl1 : 0 ≤ Real.log (e * b' / (b' - e)) := Real.log_nonneg hq1
  have hl2 : Real.log (e * b' / (b' - e)) ≤ Real.log (e * b / (b - e)) :=
    Real.log_le_log (by linarith) hq
  have hlb : 0 < Real.log b := Real.log_pos (by linarith)
  have hlb' : Real.log b ≤ Real.log b' := Real.log_le_log (by linarith) hbr
  have key : Real.logb b' (e * b' / (b' - e)) ≤ Real.logb b (e * b / (b - e)) := by
    unfold Real.logb
    calc Real.log (e * b' / (b' - e)) / Real.log b'
        ≤ Real.log (e * b' / (b' - e)) / Real.log b :=
          div_le_div_of_nonneg_left hl1 hlb hlb'
      _ ≤ Real.log (e * b / (b - e)) / Real.log b :=
          div_le_div_of_nonneg_right hl2 hlb.le
  linarith

end Munchausen
