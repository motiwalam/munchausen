// The exact search of src/search.rs on the GPU. One subgroup of 16 lanes
// runs one depth-first search, and it plays the part of an AVX2 register:
// component c of lane l holds digit l + 16 c of every digit vector, with
// C = 2 components for up to 30 digits (W = 1) and C = 4 for up to 62
// (W = 2). A ballot replaces movemask, so every branch depends only on
// values that are the same in all lanes, and the lanes never diverge.
// Values that are the same in all lanes cost a full instruction each, and
// a 16-lane instruction issues in one cycle where a 32-lane one takes two,
// so 16 lanes with several digits each beat 32 lanes with one.
//
// Work items are cursors: a node, its digit k, and the next count e to try.
// A fresh unit from the host also counts its node. When a subgroup has
// visited `budget` nodes in this dispatch, it writes every pending cursor
// on its stack back as a new work item and stops. The host runs the new
// items in a later dispatch. So no dispatch runs long, and large subtrees
// split by themselves.
//
// Digit vectors in buffers are stored lane by lane: byte l * C + c holds
// digit l + 16 c, so that a lane reads its digits with one load.
#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 64) in;

// per digit count: d, kmax, then table offsets in digit vectors, then the
// word offsets of the tables of the typical-set test
const uint P_D = 0, P_KMAX = 1, P_W = 2, P_DHI = 3, P_SHIFT = 4, P_DROP = 5, P_TW0 = 6, P_POWLO = 7, P_MAXV = 8, P_LF = 9, P_G = 10, P_A = 11, P_RES = 12, P_ROK = 13, P_STRIDE = 16;
// a work item: a 16-byte header, then t, hi, te, chi and cnt as digit vectors
const uint H_PI = 0, H_K = 1, H_E = 2, H_OCCK = 3, H_PP = 4, H_RF = 5, H_ROOT = 6;
const uint VB = 32 * W;            // bytes per digit vector
const uint ITEM = 16 + 5 * VB;
const uint FOUND = 16 + 64;
const uint MAXLEV = 62;

layout(std430, binding = 0) readonly buffer Pars { uint par[]; };
layout(std430, binding = 1) readonly buffer Tabs { uint tab[]; };
layout(std430, binding = 2) readonly buffer Items { uint item[]; };
layout(std430, binding = 3) writeonly buffer Outs { uint8_t outr[]; };
// per subgroup: nodes, evals
layout(std430, binding = 4) buffer Stats { uint64_t stats[]; };
layout(std430, binding = 5) writeonly buffer Found { uint8_t found[]; };
// 0: next item, 1: items written, 2: solutions found
layout(std430, binding = 6) buffer Ctl { uint ctl[]; };

layout(push_constant) uniform PC {
    uint nitems;
    uint budget;
    uint maxout;
    uint maxfound;
    uint b;
    // whether the typical-set test (--zscore) is on
    uint zrule;
} pc;

uint lane;
uint B;

// L lanes per subgroup, each with C digits: component c of lane l holds
// digit l + L c
const uint L = 32 * W / C;
#if C == 1
#define DV uint
#define BV bool
#define VEQ(a, b) ((a) == (b))
#define VNE(a, b) ((a) != (b))
#define VGE(a, b) ((a) >= (b))
#define VGT(a, b) ((a) > (b))
#define VLT(a, b) ((a) < (b))
#define ALL(v) (v)
#define COMP(v, c) (v)
#elif C == 2
#define DV uvec2
#define BV bvec2
#elif C == 4
#define DV uvec4
#define BV bvec4
#endif
#if C > 1
#define VEQ(a, b) equal(a, b)
#define VNE(a, b) notEqual(a, b)
#define VGE(a, b) greaterThanEqual(a, b)
#define VGT(a, b) greaterThan(a, b)
#define VLT(a, b) lessThan(a, b)
#define ALL(v) all(v)
#define COMP(v, c) (v)[c]
#endif
#if W == 1
#define MASK uint
const MASK ONES = 0xffffffffu;
const uint MBITS = 32u;
uvec2 words(MASK m) { return uvec2(m, 0u); }
uint popc(MASK m) { return bitCount(m); }
int msb(MASK m) { return findMSB(m); }
uint lsb(MASK m) { return uint(findLSB(m)); }
MASK bit(uint i) { return 1u << i; }
#else
#define MASK uint64_t
const MASK ONES = ~uint64_t(0);
const uint MBITS = 64u;
uvec2 words(MASK m) { return unpackUint2x32(m); }
uint popc(MASK m) { uvec2 v = unpackUint2x32(m); return bitCount(v.x) + bitCount(v.y); }
int msb(MASK m) { uvec2 v = unpackUint2x32(m); return v.y != 0u ? 32 + findMSB(v.y) : findMSB(v.x); }
uint lsb(MASK m) { uvec2 v = unpackUint2x32(m); return v.x != 0u ? uint(findLSB(v.x)) : 32u + uint(findLSB(v.y)); }
MASK bit(uint i) { return uint64_t(1) << i; }
#endif

DV LANEV; // the digit position of each component: lane + L c
DV HV;    // a hash of each digit value lane + L c

MASK bal(BV v) {
    uvec2 w = uvec2(0u);
    for (uint c = 0u; c < C; c++) {
        uint m = subgroupBallot(COMP(v, c)).x;
        w[(L * c) >> 5] |= m << ((L * c) & 31u);
    }
#if W == 1
    return w.x;
#else
    return packUint2x32(w);
#endif
}
// bit lane + L c of m, in component c
DV mbits(MASK m) {
    uvec2 w = words(m);
    DV r;
    for (uint c = 0u; c < C; c++) {
        COMP(r, c) = (w[(L * c) >> 5] >> (lane + ((L * c) & 31u))) & 1u;
    }
    return r;
}
uint pick(DV a, uint c) {
#if C == 1
    return a;
#elif C == 2
    return c == 0u ? a.x : a.y;
#else
    return c < 2u ? (c == 0u ? a.x : a.y) : (c == 2u ? a.z : a.w);
#endif
}
// a lane's C digits are C consecutive bytes
DV ldw(uint w) {
    uint sh = (lane * C * 8u) & 31u;
    DV r;
    for (uint c = 0u; c < C; c++) {
        COMP(r, c) = (w >> (sh + 8u * c)) & 255u;
    }
    return r;
}
DV ldv(uint idx) { return ldw(tab[idx * (VB / 4u) + (lane * C) / 4u]); }
DV ldi(uint off) { return ldw(item[off / 4u + (lane * C) / 4u]); }

void sti(uint off, DV v) {
    for (uint c = 0u; c < C; c++) {
        outr[off + lane * C + c] = uint8_t(pick(v, c));
    }
}
MASK m_nz(DV a) { return bal(VNE(a, DV(0u))); }
MASK m_eq(DV a, DV o) { return bal(VEQ(a, o)); }
MASK m_eqx(DV a, uint x) { return bal(VEQ(a, DV(x))); }
MASK m_ge(DV a, uint x) { return bal(VGE(a, DV(x))); }
// digit i of a, in every lane; i must be the same in all lanes
uint lane_of(DV a, uint i) { return subgroupBroadcast(pick(a, i / L), i % L); }
DV set_lane(DV a, uint i, uint v) { return mix(a, DV(v), VEQ(LANEV, DV(i))); }
DV add(DV a, DV o) {
    DV s = a + o;
    MASK g = bal(VGE(s, DV(B)));
    MASK p = bal(VEQ(s, DV(B - 1u)));
    DV r = s + mbits(((g << 1) + p) ^ p);
    return mix(r, r - B, VGE(r, DV(B)));
}
uint pack1(DV v) {
    uint s = 0u;
    for (uint c = 0u; c < C; c++) {
        s += pick(v, c);
    }
    return s;
}
DV hashv(DV y) {
    DV x = y * 0x9e3779b1u + 0x7f4a7c15u;
    x ^= x >> 15;
    x *= 0x85ebca77u;
    x ^= x >> 13;
    return x;
}
uint hash_of(uint y) { return hashv(DV(y)).x; }
// the sum of H(digit) over the digits of a selected by m
uint hash_lanes(DV a, MASK m) { return subgroupAdd(pack1(hashv(a) * mbits(m))); }
// the sum over digit values x of v[x] * H(x)
uint weigh(DV v) { return subgroupAdd(pack1(v * HV)); }
// the histogram of digits [0, d) of a, by digit value
DV hist(DV a, uint d) {
    DV h = DV(0u);
    for (uint j = 0; j < d; j++) {
        h += DV(VEQ(LANEV, DV(lane_of(a, j))));
    }
    return h;
}
bool all_eq(DV a, DV o) { return subgroupAll(ALL(VEQ(a, o))); }
// digits and prefix counts are below 64
DV pack5(DV t, DV h, DV te, DV ch, DV hp) { return t | (h << 6) | (te << 12) | (ch << 18) | (hp << 24); }
DV unpack_at(DV v, uint s) { return (v >> s) & 63u; }
// bits x0 to x1 of a mask, for x1 < MBITS
MASK range(uint x0, uint x1) { return (ONES >> (MBITS - 1u - x1)) & ~(bit(x0) - MASK(1)); }
// one more copy of digit i of a in the histogram h
DV count_digit(DV h, DV a, uint i) { return h + DV(VEQ(LANEV, DV(lane_of(a, i)))); }

uint nodes_here, evals_here;

// parameters of the current digit count
uint D, KMAX, OW, ODHI, OSHIFT, ODROP, OTW0, OLF, OG, OA, ORES, OROK;
MASK DM, TOP;
DV POW_LO, MAX_V;

// lanes [pp, d): the known leading digits
MASK known(uint pp) { return DM & ~(bit(pp) - MASK(1)); }

DV clip_lo(DV t) { return (m_nz(t) & ~(DM >> 1)) == MASK(0) ? POW_LO : t; }

uint count_in(DV a, uint x, MASK m) { return popc(m_eqx(a, x) & m); }

// see settle in search.rs
// hp is the histogram of the known leading digits, by digit value. It
// replaces the counts by vector compares in search.rs: a parent's prefix
// never holds more copies of a decided digit x >= k than cnt[x], so only
// the new digits can break the rule.
bool settle(uint k, inout DV ct, inout DV chi_n, inout uint cpp, inout uint crf, inout DV clo, inout DV chi, DV cnt, inout DV hp) {
    for (;;) {
        uint npp = uint(msb(~m_eq(clo, chi) & DM) + 1);
        if (npp >= cpp) {
            return true;
        }
        MASK kn = known(npp);
        MASK nw = kn & (bit(cpp) - MASK(1));
        MASK forced = nw & ~m_ge(clo, k);
        uint f = popc(forced);
        if (f > crf) {
            return false;
        }
        MASK big = nw & ~forced;
        if (big != MASK(0)) {
            do {
                uint i = lsb(big);
                big &= big - MASK(1);
                hp = count_digit(hp, clo, i);
            } while (big != MASK(0));
            if ((bal(VGT(hp, cnt)) & ~(bit(k) - MASK(1))) != MASK(0)) {
                return false;
            }
        }
        cpp = npp;
        if (f == 0u) {
            return true;
        }
        crf -= f;
        uint row = OSHIFT + k * (KMAX + 1u);
        MASK fl = forced;
        while (fl != MASK(0)) {
            uint i = lsb(fl);
            fl &= fl - MASK(1);
            uint x = lane_of(clo, i);
            hp += DV(VEQ(LANEV, DV(x)));
            if (x > 0u) {
                ct = add(ct, ldv(OW + x));
            }
            chi_n = add(chi_n, ldv(row + x));
        }
        MASK n1 = m_nz(ct), n2 = m_nz(chi_n);
        if ((n1 & ~DM) != MASK(0) || (n2 & TOP) == MASK(0)) {
            return false;
        }
        clo = (n1 & TOP) == MASK(0) ? POW_LO : ct;
        chi = (n2 & ~DM) != MASK(0) ? MAX_V : chi_n;
    }
}

bool first_digit_ok(DV lo, DV hi, uint pp, uint k, DV cnt, DV hp) {
    if (pp == 0u) {
        return true;
    }
    uint x0 = lane_of(lo, pp - 1u);
    if (x0 < k) {
        return true;
    }
    uint x1 = lane_of(hi, pp - 1u);
    return (bal(VLT(hp, cnt)) & range(x0, x1)) != MASK(0);
}

// The typical-set test of likely in search.rs, in fixed point: the child
// with counts cnt, prefix histogram hp, pp unknown positions and rf free
// slots fails if lneed + G[k][rf] > A[k][pp] (see gpu_tables).
bool likely(uint k, DV cnt, DV hp, uint pp, uint rf) {
    if (pc.zrule == 0u) {
        return true;
    }
    int a = int(tab[OA + k * (D + 1u) + pp]);
    if (a == 0x7fffffff) {
        return true;
    }
    uint s = 0u;
    for (uint c = 0u; c < C; c++) {
        uint x = pick(LANEV, c);
        if (x >= k && x <= KMAX) {
            s += tab[OLF + pick(cnt, c) - pick(hp, c)];
        }
    }
    int lneed = int(subgroupAdd(s));
    return lneed + int(tab[OG + k * (D + 1u) + rf]) <= a;
}

// The residue rule of search.rs, for a node with one free slot below k.
// The multiset holds cnt[x] copies of each x >= k and hp[x] copies of each
// x < k, since every known leading digit below k was forced.
bool res_ok(uint k, DV cnt, DV hp) {
    uint q = B - 1u;
    DV c = mix(hp, cnt, VGE(LANEV, DV(k)));
    for (uint m = 0u; m < 2u; m++) {
        uint r = subgroupAdd(pack1(c * ldv(ORES + m))) % q;
        if (((tab[OROK + (2u * k + m) * 4u + (r >> 5)] >> (r & 31u)) & 1u) != 0u) {
            return true;
        }
    }
    return false;
}

void report(uint mode, DV s) {
    uint slot = 0u;
    if (subgroupElect()) {
        slot = atomicAdd(ctl[2], 1u);
    }
    slot = subgroupBroadcastFirst(slot);
    if (slot >= pc.maxfound) {
        return;
    }
    uint o = slot * FOUND;
    if (subgroupElect()) {
        found[o] = uint8_t(mode);
        found[o + 1u] = uint8_t(D);
    }
    for (uint c = 0u; c < C; c++) {
        found[o + 16u + L * c + lane] = uint8_t(pick(s, c));
    }
}

// see leaf in search.rs; a hash of the digit multiset filters the candidates
// before the exact comparison of histograms
void leaf(DV t, uint pp, uint rf, DV cnt, DV hp) {
    uint o0 = lane_of(hp, 0u), o1 = lane_of(hp, 1u);
    DV c2 = set_lane(set_lane(cnt, 0u, 0u), 1u, 0u);
    uint want2 = weigh(c2);
    uint h0 = hash_of(0u), h1 = hash_of(1u);
    MASK dm = DM;
    MASK topbit = bit(D - 1u);
    DV s1 = add(t, ldv(OTW0 + o0 + rf));
    DV s0 = t;
    DV one = ldv(OTW0 + 1u);
    MASK nz1 = m_nz(s1);
    bool ok1 = (nz1 & ~dm) == MASK(0) && (nz1 & topbit) != MASK(0);
    uint g1 = ok1 ? hash_lanes(s1, dm) : 0u;
    for (uint e = 0u; e <= rf; e++) {
        uint c1 = o1 + e, c0 = o0 + rf - e;
        uint want = want2 + c0 * h0 + c1 * h1;
        if (ok1 && g1 == want) {
            if (all_eq(hist(s1, D), set_lane(set_lane(c2, 0u, c0), 1u, c1))) {
                report(1u, s1);
            }
        }
        MASK nz = m_nz(s0);
        if ((nz & ~dm) == MASK(0) && (nz & topbit) != MASK(0)) {
            if (hash_lanes(s0, dm) == want) {
                if (all_eq(hist(s0, D), set_lane(set_lane(c2, 0u, c0), 1u, c1))) {
                    report(0u, s0);
                }
            }
        }
        s0 = add(s0, one);
    }
}

void load_params(uint pi) {
    uint o = pi * P_STRIDE;
    D = par[o + P_D];
    KMAX = par[o + P_KMAX];
    OW = par[o + P_W];
    ODHI = par[o + P_DHI];
    OSHIFT = par[o + P_SHIFT];
    ODROP = par[o + P_DROP];
    OTW0 = par[o + P_TW0];
    OLF = par[o + P_LF];
    OG = par[o + P_G];
    OA = par[o + P_A];
    ORES = par[o + P_RES];
    OROK = par[o + P_ROK];
    POW_LO = ldv(par[o + P_POWLO]);
    MAX_V = ldv(par[o + P_MAXV]);
    DM = bit(D) - MASK(1);
    TOP = ~(DM >> 1);
}

// the DFS stack: per level, t, hi, te, chi and hp packed in one word per digit,
// and e, occk, pp, rf packed in one word
DV stk[MAXLEV];
uint sst[MAXLEV];

void write_item(uint pi, uint k, uint e, uint occk, uint pp, uint rf, DV t, DV hi, DV te, DV chi, DV cnt) {
    uint slot = 0u;
    if (subgroupElect()) {
        slot = atomicAdd(ctl[1], 1u);
    }
    slot = subgroupBroadcastFirst(slot);
    // the host sizes the output for every possible item
    uint o = slot * ITEM;
    {
        uint v = lane == H_PI ? pi : lane == H_K ? k : lane == H_E ? e : lane == H_OCCK ? occk : lane == H_PP ? pp : lane == H_RF ? rf : 0u;
        outr[o + lane] = uint8_t(v);
    }
    sti(o + 16u, t);
    sti(o + 16u + VB, hi);
    sti(o + 16u + 2u * VB, te);
    sti(o + 16u + 3u * VB, chi);
    sti(o + 16u + 4u * VB, cnt);
}

// Search the subtree of one work item. Returns false if the budget ran out;
// the pending cursors are then written out.
bool run_item(uint idx) {
    uint o = idx * ITEM;
    uint h0 = item[o / 4u], h1 = item[o / 4u + 1u];
    uint pi = h0 & 255u;
    uint k = (h0 >> 8) & 255u;
    uint e = (h0 >> 16) & 255u;
    uint occk = h0 >> 24;
    uint pp = h1 & 255u;
    uint rf = (h1 >> 8) & 255u;
    bool root = ((h1 >> 16) & 255u) != 0u;
    load_params(pi);
    DV nt = ldi(o + 16u);
    DV nhi = ldi(o + 16u + VB);
    DV te = ldi(o + 16u + 2u * VB);
    DV chi = ldi(o + 16u + 3u * VB);
    DV cnt = ldi(o + 16u + 4u * VB);
    DV nhp = DV(0u);
    {
        DV lo = clip_lo(nt);
        for (uint j = pp; j < D; j++) {
            nhp = count_digit(nhp, lo, j);
        }
    }
    if (root) {
        nodes_here++;
        if (k == 1u) {
            leaf(nt, pp, rf, cnt, nhp);
            return nodes_here < pc.budget;
        }
        // Cursor::new
        // a unit's hi already holds the drop for its cursor (see Node in search.rs)
        occk = lane_of(nhp, k);
        te = nt;
        chi = nhi;
        e = 0u;
    }
    uint sp = 0u;
    for (;;) {
        // next_child: the cursor is (nt, nhi, pp, rf) with k, e, te, chi, occk
        bool got = false;
        DV ct, chn, clo, chc, chp;
        uint cpp = 0u, crf = 0u;
        DV wk = ldv(OW + k), dhi = ldv(ODHI + k);
        while (e <= rf) {
            uint ee = e;
            e++;
            if (ee > 0u) {
                te = add(te, wk);
                chi = add(chi, dhi);
            }
            evals_here++;
            uint ck = occk + ee;
            if (rf - ee == 1u && !res_ok(k, set_lane(cnt, k, ck), nhp)) {
                continue;
            }
            MASK nlo = m_nz(te);
            if ((nlo & ~DM) != MASK(0)) {
                e = rf + 1u;
                break;
            }
            MASK nhm = m_nz(chi);
            if ((nhm & TOP) == MASK(0)) {
                continue;
            }
            cnt = set_lane(cnt, k, ck);
            clo = (nlo & TOP) == MASK(0) ? POW_LO : te;
            chc = (nhm & ~DM) != MASK(0) ? MAX_V : chi;
            ct = te;
            chn = chi;
            cpp = pp;
            crf = rf - ee;
            chp = nhp;
            if (settle(k, ct, chn, cpp, crf, clo, chc, cnt, chp) && first_digit_ok(clo, chc, cpp, k, cnt, chp) && (crf != 1u || res_ok(k, cnt, chp))
                && likely(k, cnt, chp, cpp, crf)) {
                got = true;
                break;
            }
        }
        if (got) {
            nodes_here++;
            if (k == 2u) {
                leaf(ct, cpp, crf, cnt, chp);
            } else {
                stk[sp] = pack5(nt, nhi, te, chi, nhp);
                sst[sp] = e | (occk << 8) | (pp << 16) | (rf << 24);
                sp++;
                k--;
                nt = ct;
                nhi = chn;
                pp = cpp;
                rf = crf;
                nhp = chp;
                occk = lane_of(nhp, k);
                te = nt;
                chi = add(nhi, ldv(ODROP + k * (D + 1u) + rf));
                e = 0u;
            }
            if (nodes_here >= pc.budget) {
                // hand back every cursor that still has children to try
                if (e <= rf) {
                    write_item(pi, k, e, occk, pp, rf, nt, nhi, te, chi, cnt);
                }
                for (uint i = sp; i > 0u; i--) {
                    uint s = sst[i - 1u];
                    uint ke = k + (sp - i + 1u);
                    uint se = s & 255u, srf = s >> 24;
                    if (se <= srf) {
                        write_item(pi, ke, se, (s >> 8) & 255u, (s >> 16) & 255u, srf, unpack_at(stk[i - 1u], 0u), unpack_at(stk[i - 1u], 6u),
                                   unpack_at(stk[i - 1u], 12u), unpack_at(stk[i - 1u], 18u), cnt);
                    }
                }
                return false;
            }
        } else {
            if (sp == 0u) {
                return true;
            }
            sp--;
            k++;
            uint s = sst[sp];
            nt = unpack_at(stk[sp], 0u);
            nhi = unpack_at(stk[sp], 6u);
            te = unpack_at(stk[sp], 12u);
            chi = unpack_at(stk[sp], 18u);
            nhp = unpack_at(stk[sp], 24u);
            e = s & 255u;
            occk = (s >> 8) & 255u;
            pp = (s >> 16) & 255u;
            rf = s >> 24;
        }
    }
}

void main() {
    lane = gl_SubgroupInvocationID;
    B = pc.b;
    uint sg = gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID;
    for (uint c = 0u; c < C; c++) {
        COMP(LANEV, c) = lane + L * c;
    }
    HV = hashv(LANEV);
    nodes_here = 0u;
    evals_here = 0u;
    for (;;) {
        uint idx = 0u;
        if (subgroupElect()) {
            idx = atomicAdd(ctl[0], 1u);
        }
        idx = subgroupBroadcastFirst(idx);
        if (idx >= pc.nitems) {
            break;
        }
        if (!run_item(idx)) {
            break;
        }
    }
    if (subgroupElect()) {
        stats[2u * sg] += uint64_t(nodes_here);
        stats[2u * sg + 1u] += uint64_t(evals_here);
    }
}
